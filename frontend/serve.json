{
  "cleanUrls": false,
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), identity-credentials-get=*, microphone=(), camera=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
