                onClick={() => !readOnly && onEditHourType(hourType)}
                title={readOnly ? hourType : `Nhấn để đổi tên: ${hourType}`}
              >
                {hourType}
              </span>
            )}
            {!readOnly && hourTypes.length > 1 && (
              <button
                onClick={e => { e.preventDefault(); e.stopPropagation(); onRemoveHourType(hourType); }}
