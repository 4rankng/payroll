  [data-admin-ui] .admin-dashboard-bento :where([class*="ring-border"]) {
    box-shadow: none !important;
  }

  [data-admin-ui] .admin-dashboard-bento :where(
    [class*="hover:-translate"],
    [class*="hover:scale"],
    [class*="active:scale"]
  ) {
    transform: none !important;
  }

  [data-admin-ui] .admin-dashboard-section-header {
    padding-left: 0.15rem;
  }

  [data-admin-ui] .admin-dashboard-ledger-strip {
    border-top: 1px solid hsl(var(--border) / 0.68);
    border-bottom: 1px solid hsl(var(--border) / 0.68);
    background: hsl(var(--muted) / 0.42);
  }

  [data-admin-ui] .admin-dashboard-bento :is(button, [role="button"]) {
    min-height: 2.75rem;
  }

  [data-admin-ui] .admin-page-inner .bg-white {
    background-color: hsl(var(--card));
  }

  [data-admin-ui] .admin-page-inner :is(table, [data-slot="mobile-table"]) {
    font-variant-numeric: tabular-nums lining-nums;
  }

  [data-admin-ui] .admin-page-inner :is(button, a, input, textarea, [role="button"], [role="combobox"]):focus-visible,
  html.admin-route-active :is([role="dialog"], [role="menu"], [role="listbox"])
    :is(button, a, input, textarea, [role="button"], [role="option"]):focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }

  html.admin-route-active [role="dialog"] {
    border-color: hsl(var(--border));
    background-color: hsl(var(--popover));
    color: hsl(var(--popover-foreground));
  }

  html.admin-route-active :is([role="menu"], [role="listbox"]) {
    border-color: hsl(var(--border));
    background-color: hsl(var(--popover));
    color: hsl(var(--popover-foreground));
  }

  @media (min-width: 1024px) {
    [data-admin-ui] .admin-page-frame {
      padding-bottom: 0;
    }

    [data-admin-ui] .admin-page-header {
      padding: 0;
    }

    [data-admin-ui] .admin-page-header [data-slot="page-header-controls"] button,
    [data-admin-ui] .admin-page-header [data-slot="page-header-controls"] [role="combobox"],
    [data-admin-ui] .admin-filter-bar button,
    [data-admin-ui] .admin-filter-bar input,
    [data-admin-ui] .admin-filter-bar [role="combobox"] {
      min-height: 2.5rem;
    }
  }

  @media (max-width: 639px) {
    [data-admin-ui] .admin-page-header {
      border-radius: 1.1rem;
    }

    [data-admin-ui] .admin-page-header [data-slot="page-header-controls"] {
      width: 100%;
    }

    [data-admin-ui] .admin-page-header [data-slot="page-header-controls"] > * {
      min-width: 2.75rem;
    }

    [data-admin-ui] .admin-filter-bar {
      border-radius: 1rem;
    }

    [data-admin-ui] .admin-pagination {
      flex-wrap: wrap;
    }

    [data-admin-ui] .admin-pagination button,
    [data-admin-ui] .admin-pagination [role="combobox"] {
      min-width: 2.75rem;
      min-height: 2.75rem;
      border-radius: 0.75rem;
    }
}

[data-admin-ui] .admin-kicker {
    color: hsl(var(--sidebar-foreground) / 0.62);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  [data-admin-ui] .admin-subtle-copy {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    line-height: 1.45;
  }

  [data-admin-ui] .admin-tabular {
    font-family: var(--admin-font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
}
