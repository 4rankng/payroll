      <div className="mx-auto max-w-[1320px] space-y-5">
        <div className="relative overflow-hidden rounded-3xl border border-primary/15 bg-card p-5 shadow-[0_20px_54px_-42px_rgba(6,101,52,0.44)] md:p-6">
