		},
		{
			name: "valid date",
			input: func() *time.Time {
				t := time.Date(2024, 1, 15, 10, 30, 0, 0, time.UTC)
				return &t
			}(),
			expected: "2024-01-15",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
