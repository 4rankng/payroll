          <div className="space-y-2">
            <SectionHeader icon={Activity} title="Sức khỏe vận hành" />
            <CheckInHealthStrip month={monthParam} />
          </div>
        </DashboardDisclosureSection>
      </Accordion>
    </MobilePageShell>
  );
};

export default AdminDashboardMobile;
