<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Quản lý người dùng — TingTing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    /* Brand */
    --navy-900: #0A1228;
    --navy-800: #0F1A38;
    --navy-700: #18234A;
    --navy-600: #243161;
    --navy-500: #3B4A82;
    --navy-100: #E6E9F4;

    /* Surfaces */
    --bg: #F4F5F8;
    --bg-warm: #EFEFEA;
    --card: #FFFFFF;
    --charcoal: #11151E;
    --charcoal-2: #1A1F2C;
    --charcoal-3: #262B38;

    /* Ink */
    --ink-900: #0B1020;
    --ink-700: #2B3142;
    --ink-500: #5A627A;
    --ink-400: #8189A0;
    --ink-300: #A8AEC2;
    --ink-200: #CFD3DF;
    --ink-100: #E8EAF1;
    --ink-50:  #F4F5F8;
    --on-charcoal: #F5F6FA;
    --on-charcoal-dim: #9CA3B4;

    /* Accents */
    --lime: #C5F23B;
    --lime-deep: #9DCB1F;
    --emerald: #19B97A;
    --amber: #E8A82B;
    --rose: #E5484D;
    --violet: #7C5CFF;
    --sky: #2B8DFF;

    /* Misc */
    --radius: 14px;
    --radius-sm: 8px;
    --shadow-card: 0 1px 0 rgba(15, 26, 56, 0.04), 0 1px 2px rgba(15, 26, 56, 0.04);
    --shadow-pop: 0 12px 32px -8px rgba(11, 16, 32, 0.18), 0 4px 12px -2px rgba(11, 16, 32, 0.08);
    --border: rgba(11, 16, 32, 0.08);
    --border-soft: rgba(11, 16, 32, 0.06);
  }

  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--ink-900);
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'ss01', 'cv11';
  }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input { font-family: inherit; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-feature-settings: 'zero', 'ss01'; }

  /* ---------- APP SHELL ---------- */
  .app { display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; }

  /* ---------- SIDEBAR ---------- */
  .sidebar {
    background: var(--navy-900);
    color: var(--on-charcoal);
    display: flex; flex-direction: column;
    border-right: 1px solid rgba(255,255,255,0.04);
    position: relative;
  }
  .sidebar::after {
    /* faint vertical light line for depth */
    content: '';
    position: absolute; top: 0; right: 0; bottom: 0; width: 1px;
    background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(197,242,59,0.18) 30%, rgba(255,255,255,0) 80%);
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    padding: 22px 22px 24px;
  }
  .brand-mark {
    width: 32px; height: 32px; border-radius: 9px;
    background: var(--lime);
    display: grid; place-items: center;
    color: var(--navy-900); font-weight: 800; font-size: 16px;
    box-shadow: 0 0 0 4px rgba(197,242,59,0.12);
  }
  .brand-name { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
  .brand-name .dot { color: var(--lime); }

  .nav-group { padding: 8px 14px; }
  .nav-group-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 10px 10px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--on-charcoal-dim); text-transform: uppercase;
  }
  .nav-group-header svg { opacity: 0.5; }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 10px;
    color: var(--ink-200);
    font-size: 14px; font-weight: 500;
    text-decoration: none;
    margin: 2px 0;
    position: relative;
    transition: background 0.15s, color 0.15s;
  }
  .nav-item:hover { background: rgba(255,255,255,0.04); color: #fff; }
  .nav-item.active {
    background: linear-gradient(180deg, rgba(197,242,59,0.10) 0%, rgba(197,242,59,0.04) 100%);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(197,242,59,0.20);
  }
  .nav-item.active::before {
    content: ''; position: absolute; left: -14px; top: 8px; bottom: 8px;
    width: 3px; background: var(--lime); border-radius: 0 3px 3px 0;
  }
  .nav-item .badge {
    margin-left: auto; font-size: 11px; font-weight: 700;
    background: rgba(197,242,59,0.18); color: var(--lime);
    padding: 2px 7px; border-radius: 999px;
  }

  .sidebar-foot { margin-top: auto; padding: 14px; }
  .user-pill {
    display: flex; align-items: center; gap: 12px;
    padding: 12px; border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .user-pill .ava {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, #C5F23B, #19B97A);
    display: grid; place-items: center;
    color: var(--navy-900); font-weight: 800; font-size: 14px;
    position: relative;
  }
  .user-pill .ava::after {
    content: ''; position: absolute; right: -2px; bottom: -2px;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--emerald);
    border: 2px solid var(--navy-900);
  }
  .user-pill .who { display: flex; flex-direction: column; line-height: 1.25; flex: 1; min-width: 0; }
  .user-pill .who small { font-size: 10px; color: var(--on-charcoal-dim); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
  .user-pill .who strong { font-size: 14px; font-weight: 700; color: #fff; }
  .ver { text-align: center; font-size: 11px; color: var(--on-charcoal-dim); margin-top: 10px; letter-spacing: 0.05em; }

  /* ---------- MAIN ---------- */
  .main { display: flex; flex-direction: column; min-width: 0; }

  /* Topbar */
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px;
    background: var(--card);
    border-bottom: 1px solid var(--border-soft);
  }
  .crumbs { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-500); }
  .crumbs .sep { color: var(--ink-300); }
  .crumbs .here { color: var(--ink-900); font-weight: 600; }

  .top-actions { display: flex; align-items: center; gap: 8px; }
  .icon-btn {
    width: 36px; height: 36px; border-radius: 10px;
    display: grid; place-items: center;
    color: var(--ink-500);
    border: 1px solid transparent;
    transition: background 0.15s, color 0.15s;
    position: relative;
  }
  .icon-btn:hover { background: var(--ink-50); color: var(--ink-900); }
  .icon-btn .pulse {
    position: absolute; top: 8px; right: 8px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--rose);
    box-shadow: 0 0 0 3px rgba(229,72,77,0.18);
  }

  /* ---------- CONTENT ---------- */
  .content { padding: 28px 32px 60px; max-width: 1600px; width: 100%; margin: 0 auto; }

  /* Page Header */
  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .page-head h1 {
    font-size: 30px; font-weight: 800; letter-spacing: -0.02em;
    margin: 0 0 6px; color: var(--ink-900);
  }
  .page-head h1 .accent { color: var(--ink-400); font-weight: 600; }
  .page-head p { margin: 0; color: var(--ink-500); font-size: 14px; max-width: 560px; }
  .head-actions { display: flex; gap: 10px; flex-shrink: 0; }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: 10px;
    font-size: 13.5px; font-weight: 600;
    border: 1px solid transparent;
    transition: transform 0.05s, background 0.15s, border-color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }
  .btn:active { transform: translateY(1px); }
  .btn-ghost {
    color: var(--ink-700);
    background: var(--card);
    border-color: var(--border);
  }
  .btn-ghost:hover { background: var(--ink-50); border-color: var(--ink-200); }
  .btn-primary {
    background: var(--charcoal); color: #fff;
    box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset, 0 6px 14px -4px rgba(11,16,32,0.30);
  }
  .btn-primary:hover { background: #000; }
  .btn-primary .kbd {
    margin-left: 4px; font-family: 'JetBrains Mono', monospace;
    font-size: 11px; padding: 2px 5px; border-radius: 4px;
    background: rgba(255,255,255,0.10); color: rgba(255,255,255,0.7);
  }

  /* ---------- STATS ---------- */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
  .stat {
    background: var(--charcoal);
    color: var(--on-charcoal);
    border-radius: var(--radius);
    padding: 20px 22px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .stat.alt { background: var(--card); color: var(--ink-900); border: 1px solid var(--border); }
  .stat .label {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-charcoal-dim);
    margin-bottom: 12px;
  }
  .stat.alt .label { color: var(--ink-500); }
  .stat .value {
    font-size: 38px; font-weight: 800; letter-spacing: -0.03em; line-height: 1;
  }
  .stat .value sub {
    font-size: 14px; font-weight: 600; color: var(--on-charcoal-dim);
    margin-left: 6px; vertical-align: baseline;
  }
  .stat.alt .value sub { color: var(--ink-400); }
  .stat .meta {
    display: flex; align-items: center; gap: 8px;
    margin-top: 14px;
    font-size: 12.5px; color: var(--on-charcoal-dim);
  }
  .stat.alt .meta { color: var(--ink-500); }
  .delta {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 7px; border-radius: 999px;
    font-size: 11.5px; font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
  }
  .delta.up { color: var(--lime); background: rgba(197,242,59,0.10); }
  .delta.down { color: #FF8B8E; background: rgba(229,72,77,0.10); }
  .stat.alt .delta.up { color: #1E8F5E; background: rgba(25,185,122,0.10); }

  .stat .glyph {
    width: 28px; height: 28px; border-radius: 8px;
    background: rgba(255,255,255,0.06);
    display: grid; place-items: center;
    color: var(--on-charcoal);
  }
  .stat.alt .glyph { background: var(--ink-50); color: var(--ink-700); }

  /* tiny sparkline */
  .spark { display: block; width: 90px; height: 28px; }

  /* highlight stat */
  .stat.hl::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 80% at 100% 0%, rgba(197,242,59,0.20), transparent 60%),
      radial-gradient(40% 60% at 0% 100%, rgba(124,92,255,0.15), transparent 70%);
  }

  /* ---------- TABLE CARD ---------- */
  .table-card {
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* Toolbar */
  .toolbar {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-soft);
    flex-wrap: wrap;
  }
  .search {
    position: relative; flex: 1; min-width: 280px; max-width: 420px;
  }
  .search input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: 13.5px;
    background: var(--ink-50);
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
    outline: none;
    color: var(--ink-900);
  }
  .search input::placeholder { color: var(--ink-400); }
  .search input:focus {
    background: #fff; border-color: var(--charcoal);
    box-shadow: 0 0 0 4px rgba(11,16,32,0.06);
  }
  .search .icon {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    color: var(--ink-400);
  }
  .search .kbd {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--ink-400); padding: 3px 6px; border-radius: 5px;
    background: var(--card); border: 1px solid var(--border-soft);
  }

  .chips { display: flex; gap: 6px; align-items: center; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 13px; font-weight: 500;
    color: var(--ink-700);
    background: var(--card);
    border: 1px solid var(--border);
    transition: background 0.15s, border-color 0.15s;
  }
  .chip:hover { background: var(--ink-50); }
  .chip.on {
    background: var(--charcoal); color: #fff; border-color: var(--charcoal);
  }
  .chip .count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-400);
    background: var(--ink-50);
    padding: 1px 6px; border-radius: 5px;
  }
  .chip.on .count { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.8); }

  .toolbar-spacer { flex: 1; }

  .view-toggle {
    display: inline-flex; background: var(--ink-50); border-radius: 9px; padding: 3px; border: 1px solid var(--border-soft);
  }
  .view-toggle button {
    padding: 6px 10px; border-radius: 7px; color: var(--ink-500); display: grid; place-items: center;
  }
  .view-toggle button.on { background: #fff; color: var(--ink-900); box-shadow: 0 1px 2px rgba(11,16,32,0.06); }

  /* ---------- TABLE ---------- */
  .tbl-wrap { overflow-x: auto; }
  table.tbl {
    width: 100%; border-collapse: collapse;
    font-size: 13.5px;
  }
  .tbl thead th {
    text-align: left;
    padding: 14px 18px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.10em;
    color: var(--ink-400); text-transform: uppercase;
    border-bottom: 1px solid var(--border-soft);
    background: #FBFBFC;
    white-space: nowrap;
    user-select: none;
  }
  .tbl thead th.sortable { cursor: pointer; }
  .tbl thead th.sortable:hover { color: var(--ink-700); }
  .sort-ic { display: inline-flex; vertical-align: middle; margin-left: 4px; opacity: 0.6; }
  .tbl tbody tr {
    border-bottom: 1px solid var(--border-soft);
    transition: background 0.12s;
  }
  .tbl tbody tr:hover { background: #FAFBFC; }
  .tbl tbody tr:last-child { border-bottom: 0; }
  .tbl tbody td {
    padding: 14px 18px;
    vertical-align: middle;
    color: var(--ink-700);
    white-space: nowrap;
  }
  .tbl tbody tr.checked { background: rgba(197,242,59,0.06); }
  .tbl tbody tr.checked:hover { background: rgba(197,242,59,0.10); }

  /* Cells */
  .col-check { width: 36px; padding-right: 0 !important; }
  .col-idx { width: 44px; color: var(--ink-400); font-family: 'JetBrains Mono', monospace; font-size: 12px; }

  .check {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1.5px solid var(--ink-200);
    display: inline-grid; place-items: center;
    cursor: pointer; transition: all 0.12s;
    background: #fff;
  }
  .check:hover { border-color: var(--ink-400); }
  .check.on { background: var(--charcoal); border-color: var(--charcoal); }
  .check svg { opacity: 0; }
  .check.on svg { opacity: 1; color: #fff; }

  /* User cell */
  .user-cell { display: flex; align-items: center; gap: 12px; }
  .user-cell .ava {
    width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center;
    font-weight: 700; font-size: 13px;
    color: #fff;
    flex-shrink: 0;
    position: relative;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .user-cell .ava.online::after {
    content: ''; position: absolute; right: -1px; bottom: -1px;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--emerald);
    border: 2px solid #fff;
  }
  .user-cell .id { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .user-cell .id strong { color: var(--ink-900); font-weight: 600; font-size: 13.5px; }
  .user-cell .id span { color: var(--ink-400); font-size: 12px; font-family: 'JetBrains Mono', monospace; }

  /* Role pills */
  .role {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    font-size: 12px; font-weight: 600;
    line-height: 1.4;
    border: 1px solid transparent;
  }
  .role .pin { width: 6px; height: 6px; border-radius: 50%; }
  .role-staff { background: #F0F2F7; color: #3D4762; border-color: rgba(61,71,98,0.08); }
  .role-staff .pin { background: #6B7693; }
  .role-mgr { background: rgba(43,141,255,0.08); color: #1968C6; border-color: rgba(43,141,255,0.15); }
  .role-mgr .pin { background: #2B8DFF; }
  .role-acc { background: rgba(124,92,255,0.08); color: #5B41D6; border-color: rgba(124,92,255,0.15); }
  .role-acc .pin { background: #7C5CFF; }
  .role-admin { background: rgba(232,168,43,0.10); color: #9A6610; border-color: rgba(232,168,43,0.20); }
  .role-admin .pin { background: var(--amber); }

  /* Activity */
  .activity {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--ink-700);
  }
  .activity .dot {
    width: 8px; height: 8px; border-radius: 50%;
    flex-shrink: 0; position: relative;
  }
  .activity .dot.live { background: var(--emerald); box-shadow: 0 0 0 3px rgba(25,185,122,0.18); }
  .activity .dot.recent { background: var(--lime-deep); }
  .activity .dot.stale { background: var(--amber); opacity: 0.7; }
  .activity .dot.never { background: transparent; border: 1.5px solid var(--ink-300); }
  .activity .when { font-size: 13px; color: var(--ink-700); font-weight: 500; }
  .activity .ago { font-size: 11.5px; color: var(--ink-400); font-family: 'JetBrains Mono', monospace; }
  .activity.never .when { color: var(--ink-400); font-style: italic; font-weight: 400; }

  .date-cell {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px; color: var(--ink-500); font-weight: 500;
  }

  /* Row actions */
  .row-actions { display: flex; gap: 4px; opacity: 0; transition: opacity 0.15s; justify-content: flex-end; }
  .tbl tbody tr:hover .row-actions { opacity: 1; }
  .row-actions .ra {
    width: 30px; height: 30px; border-radius: 8px;
    display: grid; place-items: center;
    color: var(--ink-400);
    transition: background 0.12s, color 0.12s;
  }
  .row-actions .ra:hover { background: var(--ink-50); color: var(--ink-900); }
  .row-actions .ra.danger:hover { color: var(--rose); background: rgba(229,72,77,0.08); }

  /* Pagination */
  .pagination {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px;
    border-top: 1px solid var(--border-soft);
    font-size: 13px; color: var(--ink-500);
    background: #FBFBFC;
  }
  .pagination .per-page { display: flex; align-items: center; gap: 8px; }
  .pagination .per-page select {
    padding: 6px 26px 6px 10px;
    border-radius: 7px; border: 1px solid var(--border);
    background: #fff;
    font-family: inherit; font-size: 13px;
    color: var(--ink-900);
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%235A627A' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 8px center;
  }
  .pages { display: flex; gap: 4px; align-items: center; }
  .pg {
