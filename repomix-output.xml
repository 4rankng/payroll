	var t wallet.WalletTopup
	err := rows.Scan(&t.ID, &t.Amount, &t.BankRef, &t.OccurredAt, &t.Note, &t.CreatedBy, &t.CreatedAt, &t.UpdatedAt, &t.Version)
	if err != nil {
		return nil, fmt.Errorf("failed to scan wallet topup row: %w", err)
	}
