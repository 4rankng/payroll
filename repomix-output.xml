	assert.Error(t, err)

	// missing name
	p.ShiftNames = []ShiftName{{Range: "09:00-18:00"}}
	err = p.ValidateShiftNames(nil)
	assert.Error(t, err)
}

func TestValidateShiftNames_NameLength(t *testing.T) {
