  }
  .pg.nav { color: var(--ink-700); }
  .pg:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ---------- BULK BAR ---------- */
  .bulk-bar {
    position: fixed;
    bottom: 24px; left: 50%; transform: translate(-50%, 30px);
    background: var(--charcoal); color: var(--on-charcoal);
    border-radius: 14px;
    padding: 8px 8px 8px 20px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: var(--shadow-pop);
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .bulk-bar.show { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .bulk-bar .count {
    font-weight: 700; font-size: 14px;
  }
  .bulk-bar .count em {
    font-style: normal; color: var(--lime); font-family: 'JetBrains Mono', monospace;
    margin-right: 4px;
  }
  .bulk-bar .divider {
    width: 1px; height: 22px; background: rgba(255,255,255,0.10);
  }
  .bulk-bar .ba {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 12px; border-radius: 8px;
    font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,0.85);
    transition: background 0.15s, color 0.15s;
  }
  .bulk-bar .ba:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .bulk-bar .ba.danger:hover { background: rgba(229,72,77,0.18); color: #FF8B8E; }
  .bulk-bar .clear {
