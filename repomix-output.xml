	// Second sweep pass is a no-op (already credited) — idempotent.
	credited2, err := svc.CreditOverduePendingQuota(context.Background())
	if err != nil {
		t.Fatalf("second sweep returned error: %v", err)
	}
	if credited2 != 0 {
