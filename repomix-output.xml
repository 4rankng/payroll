  .pipe-meta-item.pending .icon { background: var(--amber-soft); color: var(--amber); }
  .pipe-meta-item.failed .icon { background: var(--red-soft); color: var(--red); }
  .pipe-meta-item.cancelled .icon { background: var(--slate-soft); color: var(--slate); }
  .pipe-meta-item .icon svg { width: 16px; height: 16px; }
  .pipe-meta-item .lbl {
    font-size: 11px; color: var(--ink-3); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;
  }
  .pipe-meta-item .row { display: flex; align-items: baseline; gap: 6px; margin-top: 2px; }
  .pipe-meta-item .count {
    font-family: var(--mono); font-size: 18px; font-weight: 600; color: var(--ink);
    letter-spacing: -0.01em;
  }
  .pipe-meta-item .amt {
    font-family: var(--mono); font-size: 11.5px; color: var(--ink-4);
  }
  .pipe-meta-item.success .count { color: var(--green-deep); }
  .pipe-meta-item.cancelled .count { color: var(--slate); }

  /* ---------- METRICS STRIP ---------- */
  .metrics {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .metric {
    padding: 18px 22px;
    display: flex; align-items: center; gap: 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    position: relative; overflow: hidden;
  }
  .metric::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
  }
  .metric.success::before { background: var(--green); }
  .metric.time::before { background: var(--violet); }
  .metric.fee::before { background: var(--amber); }

  .metric-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: grid; place-items: center; flex-shrink: 0;
  }
  .metric.success .metric-icon { background: var(--green-soft); color: var(--green-deep); }
  .metric.time .metric-icon { background: var(--violet-soft); color: var(--violet); }
  .metric.fee .metric-icon { background: var(--amber-soft); color: var(--amber); }
  .metric-icon svg { width: 20px; height: 20px; }

  .metric-body { min-width: 0; flex: 1; }
  .metric-lbl {
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-3); font-weight: 700;
  }
  .metric-val {
    font-family: var(--mono); font-size: 24px; font-weight: 600;
    letter-spacing: -0.02em; color: var(--ink); margin-top: 4px; line-height: 1;
    white-space: nowrap;
  }
  .metric-val .u { font-size: 14px; color: var(--ink-4); margin-left: 2px; }
  .metric-foot {
    font-size: 11.5px; color: var(--ink-3); margin-top: 6px;
    display: flex; align-items: center; gap: 8px;
  }
  .metric-foot .chip {
    background: var(--slate-soft); color: var(--ink-2);
    padding: 1px 6px; border-radius: 5px; font-family: var(--mono); font-weight: 500; font-size: 10.5px;
  }
  .metric-foot .chip.good { background: var(--green-soft); color: var(--green-deep); }

  .spark {
    width: 72px; height: 36px; flex-shrink: 0;
  }

  /* ---------- OPERATIONS ---------- */
  .ops { display: flex; flex-direction: column; }
  .ops-head {
    padding: 16px 24px;
    border-bottom: 1px solid var(--divider);
    display: flex; align-items: center; justify-content: space-between;
    gap: 18px;
  }

  .tabs {
    display: flex; gap: 4px; background: var(--bg); padding: 4px; border-radius: 11px;
    border: 1px solid var(--border);
  }
  .tab {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 14px; border-radius: 8px;
    font-size: 13px; color: var(--ink-3); font-weight: 500;
    cursor: pointer; transition: background 0.15s, color 0.15s;
  }
  .tab .tab-count {
    background: rgba(0,0,0,0.06); color: var(--ink-2);
    padding: 1px 7px; border-radius: 5px; font-family: var(--mono); font-size: 11px; font-weight: 600;
  }
  .tab:hover { color: var(--ink); }
  .tab.active {
    background: var(--ink); color: #fff;
    box-shadow: 0 2px 6px rgba(14, 23, 41, 0.18);
  }
  .tab.active .tab-count { background: rgba(255,255,255,0.16); color: #fff; }

  .ops-actions { display: flex; align-items: center; gap: 8px; }
  .btn {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 8px 14px;
    border-radius: 9px;
    font-family: var(--display);
    font-size: 13px; color: var(--ink-2); font-weight: 500;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 7px;
    transition: background 0.15s, border-color 0.15s, transform 0.05s;
  }
  .btn svg { width: 15px; height: 15px; }
  .btn:hover { background: var(--card-soft); border-color: var(--border-strong); }
  .btn:active { transform: translateY(1px); }
  .btn.primary {
    background: var(--ink);
    color: #fff; border-color: var(--ink);
    box-shadow: 0 2px 6px rgba(14, 23, 41, 0.18);
  }
  .btn.primary:hover { background: #1A2542; border-color: #1A2542; }

  .ops-filter {
    padding: 14px 24px;
    border-bottom: 1px solid var(--divider);
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap;
  }
  .search {
    flex: 1; min-width: 240px; max-width: 360px;
    position: relative;
    display: flex; align-items: center;
    background: var(--card-soft); border: 1px solid var(--border);
    border-radius: 9px; padding: 0 12px;
  }
  .search svg { width: 15px; height: 15px; color: var(--ink-4); }
  .search input {
    flex: 1; border: 0; outline: 0; background: transparent;
    padding: 9px 10px;
    font-family: var(--display); font-size: 13px; color: var(--ink);
  }
  .search input::placeholder { color: var(--ink-4); }
  .filter-chip {
    border: 1px solid var(--border); background: var(--card);
    border-radius: 9px;
    padding: 8px 12px;
    font-size: 13px; font-weight: 500; color: var(--ink-2);
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
  }
  .filter-chip:hover { background: var(--card-soft); }
  .filter-chip .num {
    background: var(--slate-soft); color: var(--ink-2);
    padding: 0 7px; border-radius: 5px; font-family: var(--mono); font-weight: 500; font-size: 11px;
  }
  .filter-chip svg { width: 13px; height: 13px; color: var(--ink-4); }
  .filter-spacer { flex: 1; }
  .filter-meta {
    font-size: 12px; color: var(--ink-3);
  }
  .filter-meta .num { font-family: var(--mono); font-weight: 600; color: var(--ink); }

  /* TABLE */
  .table-wrap { overflow-x: auto; }
  table.tbl { width: 100%; border-collapse: collapse; }
  .tbl thead th {
    text-align: left;
    padding: 11px 24px;
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3); font-weight: 700;
    background: var(--card-soft);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .tbl thead th .sort {
    display: inline-flex; align-items: center; gap: 4px;
    cursor: pointer;
  }
  .tbl thead th .sort svg { width: 10px; height: 10px; opacity: 0.5; }
  .tbl tbody td {
    padding: 14px 24px;
    border-bottom: 1px solid var(--divider);
    font-size: 13.5px;
    vertical-align: middle;
  }
  .tbl tbody tr:hover { background: var(--card-soft); }
  .tbl tbody tr:last-child td { border-bottom: 0; }

  .emp { display: flex; align-items: center; gap: 12px; }
  .emp-avatar {
    width: 36px; height: 36px; border-radius: 9px;
    display: grid; place-items: center;
    color: #fff; font-weight: 600; font-size: 12.5px;
    flex-shrink: 0;
    font-family: var(--display);
  }
  .emp-info .name { font-weight: 600; color: var(--ink); font-size: 13.5px; }
  .emp-info .meta {
    font-family: var(--mono); font-size: 11.5px; color: var(--ink-4);
    margin-top: 2px;
    display: flex; align-items: center; gap: 6px;
  }
  .emp-info .meta .div { color: var(--ink-5); }
  .emp-info .meta .dept {
    background: var(--slate-soft); color: var(--ink-2);
    padding: 1px 6px; border-radius: 4px; font-weight: 500;
  }

  .bank { display: flex; flex-direction: column; }
  .bank-name {
    font-weight: 500; color: var(--ink); font-size: 13px;
    display: flex; align-items: center; gap: 8px;
  }
  .bank-name .b-tag {
    display: inline-block; width: 22px; height: 22px; border-radius: 5px;
    font-size: 9.5px; color: #fff; font-weight: 700;
    display: grid; place-items: center;
    font-family: var(--display);
  }
  .b-tag.msb { background: linear-gradient(135deg, #B8242F, #8E1A23); }
  .b-tag.mb { background: linear-gradient(135deg, #1F4E96, #163A73); }
  .bank-acc { font-family: var(--mono); font-size: 11.5px; color: var(--ink-4); margin-top: 3px; padding-left: 30px; }

  .amt-cell { font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; }
  .amt-cell.zero { color: var(--amber); }
  .amt-cell.muted { color: var(--ink-4); }
  .amt-cell.good { color: var(--green-deep); }

  /* utility bar inside cell for "đã dùng" */
  .usage {
    display: flex; align-items: center; gap: 8px;
  }
  .usage-bar {
    width: 60px; height: 4px; background: var(--bg-grid); border-radius: 100px;
    overflow: hidden;
  }
  .usage-bar .fill { height: 100%; background: var(--blue); border-radius: 100px; }
  .usage-pct { font-family: var(--mono); font-size: 11px; color: var(--ink-4); }

  .row-action {
    width: 28px; height: 28px; border-radius: 7px;
    display: grid; place-items: center;
    color: var(--ink-4); cursor: pointer;
  }
  .row-action:hover { background: var(--card-soft); color: var(--ink-2); }

  /* status dots in segment */
  .pipe-seg .stat-icon {
    width: 18px; height: 18px; border-radius: 50%;
    background: rgba(255,255,255,0.2); margin-right: 8px;
    display: grid; place-items: center;
  }
  .pipe-seg .stat-icon svg { width: 11px; height: 11px; }

  @media (max-width: 1240px) {
    .treasury { grid-template-columns: 1fr; }
    .treasury-flow { border-left: 0; border-right: 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 900px) {
    .metrics { grid-template-columns: 1fr; }
    .pipe-meta { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
