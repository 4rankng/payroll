          aria-label="Đảo chiều sắp xếp"
        >
          {sortOrder === "asc" ? "Tăng" : "Giảm"}
        </Button>
      </div>

      {/* Active filter chips */}
      {activeFilterCount > 0 && (
        <div className="px-4 pb-3 flex gap-2 flex-wrap">
          {statusFilter && (
            <Badge
              variant="secondary"
              className="gap-1 cursor-pointer"
              onClick={() => updateFilters({ status: undefined })}
