		t.Fatalf("CurrentForMonth = %q, want 2026-07", got.CurrentForMonth)
	}
	if got.CurrentCycleDay != 0 {
		t.Fatalf("CurrentCycleDay = %d, want 0 outside request window", got.CurrentCycleDay)
	}
