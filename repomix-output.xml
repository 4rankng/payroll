            ) : (
              <div className={navIconClass(openGroup === ACCOUNT_GROUP)}>
                <UserCircle className="h-5 w-5" />
              </div>
            )}
            <span className={navLabelClass(openGroup === ACCOUNT_GROUP)}>Tài khoản</span>
