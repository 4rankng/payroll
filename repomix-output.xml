<script>
  // Data
  const avatarColors = [
    'linear-gradient(135deg,#F97316,#EA580C)',
    'linear-gradient(135deg,#3B82F6,#1D4ED8)',
    'linear-gradient(135deg,#A855F7,#7E22CE)',
    'linear-gradient(135deg,#EC4899,#BE185D)',
    'linear-gradient(135deg,#14B8A6,#0F766E)',
    'linear-gradient(135deg,#F59E0B,#B45309)',
    'linear-gradient(135deg,#06B6D4,#0E7490)',
    'linear-gradient(135deg,#84CC16,#4D7C0F)',
    'linear-gradient(135deg,#6366F1,#4338CA)',
  ];

  function initials(name) {
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[parts.length - 2][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function colorFor(name) {
    let h = 0;
    for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0;
    return avatarColors[h % avatarColors.length];
  }

  function fmt(n) {
    return new Intl.NumberFormat('vi-VN').format(n);
  }

  function employeeCell(name, cccd) {
    return `
      <td>
        <div class="employee">
          <div class="avatar" style="background:${colorFor(name)}">${initials(name)}</div>
          <div class="employee-info">
            <div class="employee-name">${name}<span class="role">LGD</span></div>
            <div class="employee-meta">${cccd}</div>
          </div>
        </div>
      </td>`;
  }

  // Requests data
  const requests = [
    { name:'Nguyễn Thị Hằng', cccd:'034303008585', amount:100000, fee:10000, net:90000, status:'cancelled', paid:null, latency:null, created:'25/05/2026 21:03' },
    { name:'Nguyễn Thị Hằng', cccd:'034303008585', amount:100000, fee:10000, net:90000, status:'done', paid:'25/05/2026 21:03', latency:14, created:'25/05/2026 21:03' },
    { name:'Phạm Văn Hoàng', cccd:'034097002865', amount:3660000, fee:47580, net:3612420, status:'done', paid:'25/05/2026 17:52', latency:10, created:'25/05/2026 17:52' },
    { name:'Hồ Sỹ Hồng Quân', cccd:'040205002501', amount:4200000, fee:54600, net:4145400, status:'done', paid:'25/05/2026 17:50', latency:11, created:'25/05/2026 17:50' },
    { name:'Lường Văn Thân', cccd:'014205003180', amount:2640000, fee:52800, net:2587200, status:'done', paid:'09/05/2026 15:07', latency:36420, created:'09/05/2026 04:59' },
    { name:'Chu Thái Hải', cccd:'019096003956', amount:3300000, fee:66000, net:3234000, status:'done', paid:'08/05/2026 16:15', latency:32580, created:'08/05/2026 07:12' },
    { name:'Chu Thái Hải', cccd:'019096003956', amount:60000, fee:1200, net:58800, status:'cancelled', paid:null, latency:null, created:'07/05/2026 09:48' },
    { name:'Hà Thị Miền', cccd:'034301005172', amount:2400000, fee:48000, net:2352000, status:'done', paid:'05/05/2026 11:22', latency:18, created:'05/05/2026 11:22' },
    { name:'Đỗ Duy Tuyên', cccd:'031097007863', amount:2940000, fee:58800, net:2881200, status:'done', paid:'03/05/2026 14:05', latency:22, created:'03/05/2026 14:05' },
    { name:'Nguyễn Văn Tài', cccd:'038099001234', amount:2900000, fee:58000, net:2842000, status:'done', paid:'02/05/2026 09:14', latency:15, created:'02/05/2026 09:14' },
  ];

  const statusBadge = {
    done:      '<span class="badge green">Hoàn tất</span>',
    pending:   '<span class="badge amber">Chờ xử lý</span>',
    failed:    '<span class="badge red">Thất bại</span>',
    cancelled: '<span class="badge slate">Đã hủy</span>',
  };

  function fmtLatency(secs) {
    if (secs == null) return '<span class="muted-dash">—</span>';
    if (secs < 60) return `<span class="latency fast">${secs} giây</span>`;
    if (secs < 3600) return `<span class="latency">${Math.round(secs/60)} phút</span>`;
    const h = Math.floor(secs/3600);
    const m = Math.round((secs%3600)/60);
    return `<span class="latency slow">${h} giờ ${m} phút</span>`;
  }

  function fmtDateTime(s) {
    if (!s) return '<span class="muted-dash">—</span>';
    const [d, t] = s.split(' ');
    return `<div class="time-cell"><span class="day">${d}</span> <span class="time">${t}</span></div>`;
  }

  document.getElementById('requests-body').innerHTML = requests.map(r => `
    <tr>
      ${employeeCell(r.name, r.cccd)}
      <td class="num"><span class="amount-primary">${fmt(r.amount)}</span> <span class="currency">đ</span></td>
      <td class="num"><span class="amount-fee">${fmt(r.fee)}</span> <span class="currency">đ</span></td>
      <td class="num"><span class="amount-net">${fmt(r.net)}</span> <span class="currency">đ</span></td>
      <td>${statusBadge[r.status]}</td>
      <td>${fmtDateTime(r.paid)}</td>
      <td>${fmtLatency(r.latency)}</td>
      <td>${fmtDateTime(r.created)}</td>
      <td>
        <button class="row-action" title="Chi tiết">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
        </button>
      </td>
    </tr>`).join('');

  // Employees data
  const employees = [
    { name:'Hồ Sỹ Hồng Quân', cccd:'040205002501', bank:'mb',  bankName:'Quân đội (MB)',  account:'0372022609',    limit:4200000, used:4200000, pending:0, fee:54600 },
    { name:'Phạm Văn Hoàng',  cccd:'034097002865', bank:'msb', bankName:'Hàng hải (MSB)', account:'15086015001997', limit:3660000, used:3660000, pending:0, fee:47580 },
    { name:'Nguyễn Thị Hằng', cccd:'034303008585', bank:'msb', bankName:'Hàng hải (MSB)', account:'02101010731763', limit:3480000, used:100000,  pending:0, fee:10000 },
    { name:'Chu Thái Hải',    cccd:'019096003956', bank:'mb',  bankName:'Quân đội (MB)',  account:'0730116856666', limit:3240000, used:0,       pending:0, fee:0 },
    { name:'Đỗ Duy Tuyên',    cccd:'031097007863', bank:'mb',  bankName:'Quân đội (MB)',  account:'2640117855252', limit:2940000, used:2940000, pending:0, fee:58800 },
    { name:'Lường Văn Thân',  cccd:'014205003180', bank:'mb',  bankName:'Quân đội (MB)',  account:'97305111',      limit:2640000, used:2640000, pending:0, fee:52800 },
    { name:'Hà Thị Miền',     cccd:'034301005172', bank:'msb', bankName:'Hàng hải (MSB)', account:'19038772003311',limit:2400000, used:2400000, pending:0, fee:48000 },
    { name:'Chu Thái Hải',    cccd:'019096003956', bank:'mb',  bankName:'Quân đội (MB)',  account:'0730116856666', limit:3300000, used:3300000, pending:0, fee:66000 },
    { name:'Nguyễn Văn Tài',  cccd:'038099001234', bank:'mb',  bankName:'Quân đội (MB)',  account:'9981002145',    limit:2900000, used:2900000, pending:0, fee:58000 },
  ];

  function utilization(used, limit) {
    const pct = limit > 0 ? Math.round((used / limit) * 100) : 0;
    let color = '#22C55E';
    if (pct >= 90) color = '#F59E0B';
    if (pct >= 100) color = '#EF4444';
    return `
      <div class="util">
        <div class="util-bar"><div class="util-fill" style="width:${Math.min(pct,100)}%; background:${color};"></div></div>
        <span class="util-pct">${pct}%</span>
      </div>`;
  }

  document.getElementById('employees-body').innerHTML = employees.map(e => {
    const remaining = e.limit - e.used - e.pending;
    return `
    <tr>
      ${employeeCell(e.name, e.cccd)}
      <td>
        <div class="bank-cell">
          <div class="bank-logo ${e.bank}">${e.bank === 'mb' ? 'MB' : 'MSB'}</div>
          <div class="bank-info">
            <div class="bank-name">${e.bankName}</div>
            <div class="bank-account">${e.account}</div>
          </div>
        </div>
      </td>
      <td class="num"><span class="amount-primary">${fmt(e.limit)}</span> <span class="currency">đ</span></td>
      <td class="num">${e.used > 0 ? `<span class="amount-used">${fmt(e.used)}</span>` : `<span class="amount-zero">0</span>`} <span class="currency">đ</span></td>
      <td class="num">${e.pending > 0 ? fmt(e.pending) : `<span class="amount-zero">0</span>`} <span class="currency">đ</span></td>
      <td class="num">${remaining > 0 ? `<span class="amount-net">${fmt(remaining)}</span>` : `<span class="amount-zero">0</span>`} <span class="currency">đ</span></td>
      <td class="num">${utilization(e.used, e.limit)}</td>
      <td class="num"><span class="amount-fee">${e.fee > 0 ? fmt(e.fee) : '0'}</span> <span class="currency">đ</span></td>
      <td>
        <button class="row-action" title="Chi tiết">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
        </button>
      </td>
    </tr>`;
  }).join('');

  // View switcher
  function switchView(view, btn) {
    document.querySelectorAll('.view-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.body.classList.toggle('view-employees-active', view === 'employees');
    // Update toolbar text
    document.querySelector('.toolbar-right').innerHTML = view === 'employees'
      ? 'Hiển thị <strong>9</strong> trong <strong>265</strong> nhân viên'
      : 'Hiển thị <strong>10</strong> trong <strong>10</strong> yêu cầu';
  }

  // Filter chip toggle
  document.querySelectorAll('.filter-chips .chip').forEach(c => {
    c.addEventListener('click', () => {
      document.querySelectorAll('.filter-chips .chip').forEach(x => x.classList.remove('active'));
      c.classList.add('active');
    });
  });
</script>
</body>
</html>
