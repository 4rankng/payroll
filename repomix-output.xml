	if err != nil {
		t.Fatalf("InitiateTransfer: %v", err)
	}
	if res.ProviderRef != "" {
		t.Errorf("ProviderRef = %q, want empty (payment_no=0 must not be persisted)", res.ProviderRef)
	}
}

