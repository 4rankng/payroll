  return (
    <ActivityCard
      activities={safeActivities}
      isLoading={isLoading}
      isLoadingMore={isLoadingMore}
      error={error}
      onRefresh={handleRefresh}
      onLoadMore={handleLoadMore}
      hasMoreActivities={hasMoreActivities}
      totalActivities={totalActivities}
      maxItems={undefined}
    />
  );
};
