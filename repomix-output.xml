      <div
        className="mt-4 flex h-3 overflow-hidden rounded-full bg-muted ring-1 ring-inset ring-border/40"
        role="img"
        aria-label={`Phân bổ ngân hàng nhận lương: ${distributionSummary}`}
      >
        {items.map((item) => (
          <span
            key={item.shortName}
