<file path="backend/templates/email/advance_payment_reminder.html">
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Nhắc nhở yêu cầu ứng lương</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fb;color:#172033;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fb;margin:0;padding:28px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="720" cellpadding="0" cellspacing="0" style="width:100%;max-width:720px;border-collapse:separate;border-spacing:0;">
          <tr>
            <td style="padding:0 0 14px;">
              <img src="https://tingting.vip/email-banner.jpg?v=20260709" alt="Ting Ting Soft" width="720" style="display:block;width:100%;max-width:720px;height:auto;border:0;border-radius:16px;">
            </td>
          </tr>
          <tr>
            <td style="background:#ffffff;border:1px solid #e6eaf2;border-radius:16px;padding:0;box-shadow:0 10px 30px rgba(15,23,42,0.06);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:28px 32px 8px;">
                    <p style="margin:0 0 8px;color:#64748b;font-size:13px;line-height:20px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;">Nhắc nhở xử lý</p>
                    <h1 style="margin:0;color:#111827;font-size:24px;line-height:32px;font-weight:700;">Yêu cầu ứng lương đang chờ xử lý</h1>
                    <p style="margin:8px 0 0;color:#64748b;font-size:14px;line-height:22px;">Ngày {{.Date}}</p>
                  </td>
                </tr>
                <tr>
                  <td style="padding:20px 32px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;">
                      <tr>
                        <td style="padding:18px 20px;border-right:1px solid #e2e8f0;">
                          <p style="margin:0;color:#64748b;font-size:13px;line-height:18px;">Yêu cầu chờ xử lý</p>
                          <p style="margin:4px 0 0;color:#0f172a;font-size:26px;line-height:34px;font-weight:800;">{{.TotalRequests}}</p>
                        </td>
                        <td style="padding:18px 20px;border-right:1px solid #e2e8f0;">
                          <p style="margin:0;color:#64748b;font-size:13px;line-height:18px;">Nhân viên</p>
                          <p style="margin:4px 0 0;color:#0f172a;font-size:26px;line-height:34px;font-weight:800;">{{.TotalEmployees}}</p>
                        </td>
                        <td style="padding:18px 20px;">
                          <p style="margin:0;color:#64748b;font-size:13px;line-height:18px;">Tổng tiền</p>
                          <p style="margin:4px 0 0;color:#0f172a;font-size:20px;line-height:28px;font-weight:800;">{{.TotalAmount}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:20px 32px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fff8eb;border:1px solid #fed7aa;border-radius:14px;">
                      <tr>
                        <td style="padding:16px 18px;color:#7c2d12;font-size:14px;line-height:22px;">
                          Có yêu cầu ứng lương đang chờ xử lý. Vui lòng đăng nhập vào hệ thống để kiểm tra, xử lý và cập nhật kết quả chuyển khoản.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:24px 32px 30px;">
                    <p style="margin:0 0 12px;color:#111827;font-size:16px;line-height:24px;font-weight:700;">Chi tiết yêu cầu</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e6eaf2;border-radius:14px;border-collapse:separate;border-spacing:0;">
                      <thead>
                        <tr>
                          <th align="left" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">STT</th>
                          <th align="left" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Mã NV</th>
                          <th align="left" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Tên nhân viên</th>
                          <th align="left" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Dự án</th>
                          <th align="right" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Yêu cầu</th>
                          <th align="right" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Phí</th>
                          <th align="right" style="padding:12px 10px;border-bottom:1px solid #e6eaf2;color:#64748b;font-size:12px;line-height:18px;font-weight:700;">Thực nhận</th>
                        </tr>
                      </thead>
                      <tbody>
                        {{range .Requests}}
                        <tr>
                          <td style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#334155;font-size:13px;line-height:19px;">{{.STT}}</td>
                          <td style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#334155;font-size:13px;line-height:19px;">{{.EmployeeCCCD}}</td>
                          <td style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#111827;font-size:13px;line-height:19px;font-weight:700;">{{.EmployeeName}}</td>
                          <td style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#334155;font-size:13px;line-height:19px;">{{.ProjectCode}}</td>
                          <td align="right" style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#334155;font-size:13px;line-height:19px;">{{.RequestAmount}}</td>
                          <td align="right" style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#334155;font-size:13px;line-height:19px;">{{.Fee}}</td>
                          <td align="right" style="padding:12px 10px;border-bottom:1px solid #edf2f7;color:#111827;font-size:13px;line-height:19px;font-weight:700;">{{.NetAmount}}</td>
                        </tr>
                        {{end}}
                        <tr>
                          <td colspan="4" style="padding:14px 10px;color:#0f172a;font-size:13px;line-height:19px;font-weight:800;">Tổng cộng</td>
                          <td align="right" style="padding:14px 10px;color:#0f172a;font-size:13px;line-height:19px;font-weight:800;">{{.TotalRequestAmount}}</td>
                          <td align="right" style="padding:14px 10px;color:#0f172a;font-size:13px;line-height:19px;font-weight:800;">{{.TotalFee}}</td>
                          <td align="right" style="padding:14px 10px;color:#0f172a;font-size:13px;line-height:19px;font-weight:800;">{{.TotalNetAmount}}</td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 8px 0;text-align:center;color:#94a3b8;font-size:12px;line-height:18px;">Email tự động từ TingTing.</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
</file>

