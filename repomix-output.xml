      </Sheet>

      <EmployeeDetailsSheet
        employee={selectedEmployee}
        isOpen={!!selectedEmployeeId}
        onClose={() => setSelectedEmployeeId(null)}
        onUpdate={handleUpdate}
        onDelete={handleDelete}
      />
    </>
  );
}
