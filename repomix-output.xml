  /* Fee column */
  .treasury-fee {
    padding: 22px 24px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .fee-label {
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
