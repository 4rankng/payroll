<file path="frontend/src/styles/premium.css">
/* ============================================================================
   PREMIUM COMPONENTS — Card, button, badge, table, input, scrollbar,
   gradient text, shimmer, glass, dot, masonry, mobile animations
   ============================================================================ */

@layer utilities {
  /* Premium card elevation with gradient borders */
  .premium-card {
    @apply relative rounded-xl border transition-all duration-300;
    background: linear-gradient(135deg, hsl(0 0% 100%) 0%, hsl(220 10% 98%) 100%);
    box-shadow: var(--shadow-card), 0 0 0 1px hsl(var(--border) / 0.5) inset;
  }

  .premium-card:hover {
    box-shadow: var(--shadow-elevated), 0 0 0 1px hsl(var(--primary) / 0.1) inset;
    transform: translateY(-2px);
  }

  /* Premium stat card with gradient background */
  .premium-stat-card {
    @apply relative rounded-xl border overflow-hidden;
    background: linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--muted) / 0.3) 100%);
    border-color: hsl(var(--border) / 0.6);
    box-shadow: var(--shadow-soft);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .premium-stat-card:hover {
    border-color: hsl(var(--primary) / 0.3);
    box-shadow: var(--shadow-card);
    transform: scale(1.02);
  }

  /* Premium button with gradient and glow */
  .premium-button {
    @apply relative overflow-hidden rounded-lg font-semibold transition-all duration-200;
    box-shadow: 0 4px 14px hsl(var(--primary) / 0.3);
  }

  .premium-button::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 100%);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .premium-button:hover::before {
    opacity: 1;
  }

  .premium-button:active {
    transform: scale(0.98);
  }

  /* Premium badge with gradient */
  .premium-badge {
    @apply inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md font-semibold text-xs;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.1) 0%, hsl(var(--primary) / 0.05) 100%);
    border: 1px solid hsl(var(--primary) / 0.2);
    color: hsl(var(--primary));
  }

  /* Premium table row hover */
  .premium-table-row {
    @apply transition-colors duration-150;
  }

  .premium-table-row:hover {
    background: linear-gradient(90deg, hsl(var(--muted) / 0.5) 0%, hsl(var(--muted) / 0.2) 100%);
  }

  /* Premium input with focus glow */
  .premium-input {
    @apply w-full py-3 rounded-lg border-2 transition-all duration-200;
    border-color: hsl(var(--border));
    background: hsl(var(--background));
  }

  .premium-input:focus {
    border-color: hsl(var(--success));
    box-shadow: 0 0 0 3px hsl(var(--success) / 0.1), var(--shadow-card);
    outline: none;
  }

  /* Premium scrollbar */
  .premium-scroll {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--primary) / 0.3) transparent;
  }

  .premium-scroll::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .premium-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .premium-scroll::-webkit-scrollbar-thumb {
    background: hsl(var(--primary) / 0.2);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: content-box;
  }

  .premium-scroll::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--primary) / 0.3);
    background-clip: content-box;
  }

  /* Premium gradient text */
  .premium-gradient-text {
    @apply font-display font-extrabold;
    background: linear-gradient(135deg, hsl(var(--foreground)) 0%, hsl(var(--primary)) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Premium shimmer effect for loading */
  .premium-shimmer {
    position: relative;
    overflow: hidden;
  }

  .premium-shimmer::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--muted) / 0.5) 50%,
      transparent 100%
    );
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  /* Premium hover lift effect */
  .premium-hover-lift {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .premium-hover-lift:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-elevated);
  }

  /* Premium glass morphism */
  .premium-glass {
    background: hsl(var(--card) / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.5);
  }

  /* Premium notification dot */
  .premium-dot {
    @apply h-2 w-2 rounded-full;
    background: hsl(var(--success));
    box-shadow: 0 0 0 3px hsl(var(--success) / 0.2);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% {
      box-shadow: 0 0 0 0 hsl(var(--success) / 0.4);
    }
    50% {
      box-shadow: 0 0 0 6px hsl(var(--success) / 0);
    }
  }

  /* ========================================================================
     MOBILE PAGE ANIMATIONS — anime.js + CSS hybrid
     ======================================================================== */

  @keyframes mobile-wallet-reveal {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes mobile-card-reveal {
    0% {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes mobile-section-reveal {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mobile-stat-pop {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes wallet-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @keyframes mobile-tab-slide {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* Utility classes for mobile pages */
  .mobile-wallet-hero {
    animation: mobile-wallet-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mobile-card-enter {
    animation: mobile-card-reveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mobile-section-enter {
    animation: mobile-section-reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mobile-stat-enter {
    animation: mobile-stat-pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .wallet-shimmer-bg {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(110, 168, 255, 0.06) 40%,
      rgba(110, 168, 255, 0.12) 50%,
      rgba(110, 168, 255, 0.06) 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: wallet-shimmer 3s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-wallet-hero,
    .mobile-card-enter,
    .mobile-section-enter,
    .mobile-stat-enter,
    .wallet-shimmer-bg {
      animation: none !important;
    }
  }

  /* ========================================================================
     MASONRY LAYOUTS
     ======================================================================== */

  /* CSS Columns Masonry — for uniform items (stats, small cards) */
  .masonry-grid {
    column-gap: 1rem;
    column-count: 1;
  }

  .masonry-grid > div {
    break-inside: avoid;
    margin-bottom: 1rem;
    display: block;
    width: 100%;
  }

  @media (min-width: 768px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1280px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  /* Flexbox Column Masonry — for mixed-size items (charts, tables, stats) */
  .flex-masonry {
    display: flex;
    gap: 1rem;
  }

  .flex-masonry > .flex-masonry-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 767px) {
    .flex-masonry {
      flex-direction: column;
    }
  }
}
</file>

<file path="frontend/src/styles/react-datepicker.css">
/* React Date Picker Custom Styles */
.react-datepicker {
  font-family: inherit;
  font-size: 0.75rem;
  border: 1px solid hsl(var(--border));
  border-radius: 0.625rem;
  background-color: hsl(var(--background));
  box-shadow: 0 8px 24px -4px rgb(0 0 0 / 0.12), 0 2px 8px -2px rgb(0 0 0 / 0.06);
  overflow: hidden;
}

.react-datepicker__header {
  background-color: hsl(var(--background));
  border-bottom: 1px solid hsl(var(--border) / 0.6);
  border-top-left-radius: 0.625rem;
  border-top-right-radius: 0.625rem;
  padding: 0.5rem 0.5rem 0.375rem;
}

.react-datepicker__month-container {
  float: none;
}

.react-datepicker__month {
  margin: 0.25rem 0.5rem 0.5rem;
}

.react-datepicker__day-names {
  margin-bottom: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 0.125rem;
}

.react-datepicker__day-name {
  font-size: 0.6875rem;
  font-weight: 600;
  color: hsl(var(--muted-foreground) / 0.7);
  width: 1.75rem;
  line-height: 1.75rem;
  text-align: center;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.react-datepicker__week {
  display: flex;
  justify-content: space-between;
  padding: 0 0.125rem;
}

.react-datepicker__day {
  font-size: 0.75rem;
  width: 1.75rem;
  height: 1.75rem;
  line-height: 1.75rem;
  text-align: center;
  margin: 0.0625rem 0;
  border-radius: 0.375rem;
  color: hsl(var(--foreground));
  transition: background-color 0.1s, color 0.1s;
}

.react-datepicker__day:hover {
  background-color: hsl(var(--accent));
  color: hsl(var(--accent-foreground));
}

.react-datepicker__day--selected {
  background-color: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
  font-weight: 600;
}

.react-datepicker__day--keyboard-selected {
  background-color: hsl(var(--primary) / 0.15);
  color: hsl(var(--primary));
}

.react-datepicker__day--today:not(.react-datepicker__day--selected) {
  font-weight: 700;
  color: hsl(var(--primary));
}

.react-datepicker__day--disabled {
  color: hsl(var(--muted-foreground) / 0.35);
  cursor: not-allowed;
}

.react-datepicker__day--disabled:hover {
  background-color: transparent;
}

.react-datepicker__day--outside-month {
  color: hsl(var(--muted-foreground) / 0.25);
}

.react-datepicker__triangle {
  display: none;
}

#datepicker-portal {
  pointer-events: auto;
}

.react-datepicker-popper {
  /* Sit above shadcn <Dialog>/<Sheet> overlays, which use z-50.
     Same-z siblings paint by mount order: Radix dialog portals mount
     after the date-picker body-portal, so without bumping above 50 the
     calendar renders behind the dim overlay. 70 keeps headroom under
     toaster's z-[100] used elsewhere. */
  z-index: 70;
}

.datepicker-left-shift.react-datepicker-popper {
  margin-left: -50px !important;
}

/* Month/year dropdown selects (used in custom header) */
.react-datepicker__month-select,
.react-datepicker__year-select {
  font-size: 0.75rem;
  font-weight: 600;
  color: hsl(var(--foreground));
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 0.375rem;
  padding: 0.125rem 0.25rem;
  cursor: pointer;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  transition: border-color 0.15s, background-color 0.15s;
}

.react-datepicker__month-select:hover,
.react-datepicker__year-select:hover {
  border-color: hsl(var(--border));
  background-color: hsl(var(--accent));
}

.react-datepicker__month-select:focus,
.react-datepicker__year-select:focus {
  border-color: hsl(var(--ring));
  background-color: hsl(var(--accent));
}

/* Legacy dropdown styles (fallback) */
.react-datepicker__month-read-view--down-arrow,
.react-datepicker__year-read-view--down-arrow {
  border-top-color: hsl(var(--foreground));
}

.react-datepicker__month-option,
.react-datepicker__year-option {
  font-size: 0.75rem;
  padding: 0.25rem 0.5rem;
}

.react-datepicker__month-option:hover,
.react-datepicker__year-option:hover {
  background-color: hsl(var(--accent));
}

.react-datepicker__month-option--selected_month,
.react-datepicker__year-option--selected_year {
  background-color: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

/* Time picker */
.react-datepicker__time-container {
  border-left: 1px solid hsl(var(--border));
}

.react-datepicker__time {
  background-color: hsl(var(--background));
}

.react-datepicker__time-box {
  background-color: hsl(var(--background));
}

.react-datepicker__time-list-item {
  height: 1.75rem;
  line-height: 1.75rem;
  font-size: 0.75rem;
}

.react-datepicker__time-list-item:hover {
  background-color: hsl(var(--accent));
}

.react-datepicker__time-list-item--selected {
  background-color: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
}

/* Focus styles */
.react-datepicker__day:focus {
  outline: 2px solid hsl(var(--ring));
  outline-offset: 1px;
}

/* ── Month/Year picker modes (custom grid rendered in header) ── */
/* calendarClassName="dp-grid-view" is added to .react-datepicker root itself */
.react-datepicker.dp-grid-view .react-datepicker__month,
.react-datepicker.dp-grid-view .react-datepicker__day-names {
  display: none !important;
}

.react-datepicker.dp-grid-view .react-datepicker__header {
  border-bottom: none;
  padding-bottom: 0;
}
</file>

<file path="frontend/src/styles/utilities.css">
/* ============================================================================
   UTILITY CLASSES — Typography helpers, financial colors, card elevation,
   truncation, transitions, grain texture, animation delays
   ============================================================================ */

@layer utilities {
  /* Glass card — frosted-glass card used in employee portal */
  .glass-card {
    background: rgba(255,255,255,0.80);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    border: 1.5px solid rgba(255,255,255,0.95);
    box-shadow: 0 2px 8px rgba(100,180,230,0.12), 0 8px 24px rgba(80,160,220,0.10);
  }

  /* Typography Utilities */
  .font-display {
    font-family: var(--font-family-display);
  }

  .font-financial {
    font-family: var(--font-family-financial);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1, "zero" 1;
    letter-spacing: var(--tracking-data);
  }

  /* Text Utilities */
  .text-readable {
    line-height: var(--leading-relaxed);
    letter-spacing: 0.01em;
  }

  .text-high-contrast {
    color: hsl(var(--foreground));
  }

  /* Currency Display */
  .typography-currency {
    @apply font-financial font-semibold;
  }

  /* Percentage Display */
  .typography-percentage {
    @apply font-financial font-medium;
  }

  /* Metric Display */
  .typography-metric {
    @apply font-display font-semibold;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }

  /* Table Headers */
  .typography-table-header {
    @apply font-semibold uppercase;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: hsl(var(--muted-foreground));
  }

  /* Table Cells */
  .typography-table-cell {
    @apply font-financial;
    font-size: var(--text-sm);
    line-height: var(--leading-data);
  }

  /* Status Badges */
  .typography-status {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  /* ========================================================================
     FINANCIAL SEMANTIC COLORS - Breaking Away from Generic
     ======================================================================== */
  .text-financial-positive {
    color: hsl(var(--success));
  }

  .text-financial-negative {
    color: hsl(var(--destructive));
  }

  .text-financial-pending {
    color: hsl(var(--warning));
  }

  .bg-financial-positive {
    background-color: hsl(var(--success) / 0.1);
    color: hsl(var(--success));
  }

  .bg-financial-negative {
    background-color: hsl(var(--destructive) / 0.1);
    color: hsl(var(--destructive));
  }

  .bg-financial-pending {
    background-color: hsl(var(--warning) / 0.1);
    color: hsl(var(--warning));
  }

  /* ========================================================================
     CARD ELEVATION - Premium Depth
     ======================================================================== */
  .card-elevated {
    @apply rounded-xl;
    background: linear-gradient(135deg, hsl(0 0% 100%) 0%, hsl(220 10% 98%) 100%);
    box-shadow: var(--shadow-card-elevated);
    border: 1px solid hsl(220 10% 92%);
    transition: var(--transition-smooth);
  }

  .card-elevated:hover {
    box-shadow: var(--shadow-elevated);
  }

  /* ========================================================================
     TEXT TRUNCATION - Refined Handling
     ======================================================================== */
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Mobile truncation */
  .truncate-mobile {
    @media (max-width: 640px) {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  /* ========================================================================
     TRANSITIONS - Smooth Premium Feel
     ======================================================================== */
  .transition-smooth {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ========================================================================
     GRAIN TEXTURE - Atmospheric Depth
     ======================================================================== */
  .background-grain::before {
    content: '';
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    opacity: 0.02;
    pointer-events: none;
    z-index: 9999;
  }

  /* ========================================================================
     ANIMATION DELAYS - Staggered Reveals
     ======================================================================== */
  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  .delay-400 { animation-delay: 400ms; }
  .delay-500 { animation-delay: 500ms; }

  /* ========================================================================
     SECTION WRAPPERS - Clean Spacing
     ======================================================================== */
  .section-card {
    @apply card-elevated p-6;
  }

  /* ========================================================================
     INPUT STYLES - Premium Focus States
     ======================================================================== */
  .input-financial {
    @apply w-full px-4 py-3 rounded-lg border-2;
    @apply font-financial text-sm text-foreground;
    border-color: hsl(var(--border));
    transition: all 0.2s ease;
  }

  .input-financial:focus {
    border-color: hsl(var(--success));
    box-shadow: var(--shadow-focus-success);
    outline: none;
  }

  .input-financial::placeholder {
    color: hsl(var(--muted-foreground));
    font-weight: var(--font-normal);
  }

  /* ========================================================================
     ADMIN MOBILE UTILITIES — previously dangling (no-op) classes,
     defined here so existing pages render the intended effect.
     ======================================================================== */

  /* Navy primary CTA used by admin mobile action bars.
     Matches shadcn `Button variant="default"` visual but as a raw class
     so it can be applied to <button>/<a> without the Button component. */
  .btn-admin-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    background-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-family: var(--font-family-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn-admin-primary:active {
    transform: scale(0.97);
  }

  .btn-admin-primary:disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Subtle hover/press lift for cards. */
  .card-lift {
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-lift:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-elevated);
  }

  .card-lift:active {
    transform: translateY(0);
  }

  /* Hide scrollbars while keeping scroll (horizontal stat strips, chip rows). */
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* Safe-area bottom padding for sheets/filters that sit above the nav. */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
}
