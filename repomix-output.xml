      height: 36px;
      padding: 0;
      justify-content: center;
    }

    /* ============================================================
       BENTO GRID — UUI pattern
       Outer: flex flex-col gap-6 lg:flex-row lg:gap-8
       Inner: flex flex-col gap-X (sections)
       ============================================================ */
    .bento-row {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .bento-row.between { justify-content: space-between; }
    .bento-row.items-start { align-items: flex-start; }
    .bento-row.lg-row { gap: 32px; }

    @media (min-width: 1024px) {
      .bento-row.lg-row { flex-direction: row; }
    }

    /* ===== BENTO TOP: MRR | Chart | Stats dl ===== */
    .bento-top {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 1024px) {
      .bento-top { flex-direction: row; gap: 32px; }
    }

    .mrr-block { display: flex; flex-direction: column; gap: 8px; min-width: 180px; }
    .mrr-label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-tertiary);
    }
    .mrr-value {
      display: flex;
      align-items: flex-start;
      gap: 2px;
      font-family: var(--font-display);
      font-size: 36px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .mrr-value .currency { font-size: 18px; font-weight: 500; padding-top: 2px; }

    .chart-block {
      flex: 1;
      height: 240px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    @media (min-width: 1024px) {
      .chart-block { height: 240px; }
    }

    .stats-dl {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      max-width: 240px;
    }
    .stats-dl .row { display: flex; flex-direction: column; gap: 8px; }
    .stats-dl .label { font-size: 14px; font-weight: 500; color: var(--text-tertiary); }
    .stats-dl .value-row { display: flex; align-items: center; gap: 16px; }
    .stats-dl .value {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }

    /* ===== BADGES (BadgeWithIcon / BadgeWithDot pattern) ===== */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      font-size: 12px;
      font-weight: 600;
      border-radius: var(--r-full);
      background: var(--success-50);
      color: var(--success-700);
      border: 1px solid var(--success-100);
    }
    .badge.gray { background: var(--bg-tertiary); color: var(--text-tertiary); border-color: var(--border-primary); }
    .badge.warn { background: var(--warning-50); color: var(--warning-600); border-color: var(--warning-100); }
    .badge.brand { background: var(--brand-50); color: var(--brand-700); border-color: var(--brand-100); }
    .badge .arrow { font-size: 10px; }

    /* ===== SECTION HEADER (SectionHeader.Root) ===== */
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--border-primary);
    }
    .section-head h2 {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .section-head .more {
      color: var(--text-quaternary);
      cursor: pointer;
      padding: 4px;
      border-radius: 4px;
    }
    .section-head .more:hover { background: var(--bg-tertiary); color: var(--text-secondary); }

    /* ===== ACTION CARDS (rounded-xl bg-primary ring-1) ===== */
    .action-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px;
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--r-xl);
      box-shadow: var(--shadow-xs);
      flex: 1;
      min-width: 280px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .action-card:hover {
      box-shadow: var(--shadow-sm);
      border-color: var(--border-secondary);
    }

    .featured-icon {
      width: 48px; height: 48px;
      border-radius: var(--r-lg);
      display: grid; place-items: center;
      flex-shrink: 0;
    }
    .featured-icon.brand {
      background: var(--brand-600);
      color: white;
    }
    .featured-icon.brand-soft {
      background: var(--brand-50);
      color: var(--brand-600);
    }
    .featured-icon.sm { width: 40px; height: 40px; }

    .featured-icon svg { width: 20px; height: 20px; }

    .action-card .body { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; align-items: flex-start; text-align: left; }
    .action-card .title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
    .action-card .desc { font-size: 13px; color: var(--text-tertiary); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ===== KPI TILES (MetricsIcon04 pattern) ===== */
    .kpi-row {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 768px) {
      .kpi-row { flex-direction: row; flex-wrap: wrap; gap: 20px; }
    }
    .kpi-tile {
      flex: 1;
      min-width: 280px;
      padding: 20px;
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--r-xl);
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .kpi-tile.featured { box-shadow: 0 0 0 2px var(--brand-600); border-color: var(--brand-600); }
    .kpi-tile .head { display: flex; align-items: center; gap: 8px; }
    .kpi-tile .ico {
      width: 32px; height: 32px;
      border-radius: var(--r-md);
      display: grid; place-items: center;
      background: var(--brand-50);
      color: var(--brand-600);
    }
    .kpi-tile .lbl { font-size: 13px; font-weight: 500; color: var(--text-tertiary); }
    .kpi-tile .val-row { display: flex; align-items: baseline; gap: 8px; }
    .kpi-tile .val {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }
    .kpi-tile .val-row .sub { font-size: 13px; color: var(--text-tertiary); }

    /* ===== TABLE (Table component pattern) ===== */
    .data-table {
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--r-xl);
      overflow: hidden;
    }
    .data-table table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .data-table thead th {
      text-align: left;
      padding: 12px 16px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-tertiary);
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border-primary);
    }
    .data-table tbody td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-tertiary);
      color: var(--text-secondary);
      vertical-align: middle;
    }
    .data-table tbody tr:last-child td { border-bottom: 0; }
    .data-table tbody tr:hover { background: var(--bg-secondary); }
    .data-table .num { text-align: right; font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--text-primary); }

    /* ===== ARTICLE CARDS (Simple04Vertical) ===== */
    .article-card {
      flex: 1;
      min-width: 320px;
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--r-xl);
      overflow: hidden;
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      transition: all 0.15s;
      cursor: pointer;
    }
    .article-card:hover { box-shadow: var(--shadow-sm); }
    .article-card .thumb {
      aspect-ratio: 16/10;
      background-size: cover;
      background-position: center;
      position: relative;
    }
    .article-card .thumb-overlay {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(180deg, transparent, rgba(0,0,0,0.6));
      color: white;
    }
    .article-card .author { font-size: 12px; font-weight: 600; }
    .article-card .date { font-size: 12px; opacity: 0.8; }
    .article-card .category-pill {
      position: absolute;
      bottom: 16px; right: 16px;
      padding: 3px 8px;
      background: rgba(0,0,0,0.4);
      color: white;
      font-size: 11px;
      font-weight: 600;
      border-radius: var(--r-full);
      backdrop-filter: blur(8px);
    }
    .article-card .body {
      padding: 16px 20px 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }
    .article-card h3 {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }
    .article-card p {
      font-size: 13px;
      color: var(--text-tertiary);
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .article-card .read-link {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 13px;
      font-weight: 600;
      color: var(--brand-600);
      text-decoration: none;
    }

    /* ===== FEED (Activity feed pattern) ===== */
    .feed-list { display: flex; flex-direction: column; gap: 20px; }
    .feed-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .feed-item .feed-avatar {
      width: 32px; height: 32px;
      border-radius: 50%;
      flex-shrink: 0;
      background: linear-gradient(135deg, #F59E0B, #DC2626);
      color: white;
      font-size: 11px;
      font-weight: 700;
      display: grid; place-items: center;
      position: relative;
    }
    .feed-item .feed-avatar::after {
      content: '';
      position: absolute;
      bottom: -1px; right: -1px;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--success-500);
      border: 2px solid var(--bg-primary);
    }
    .feed-item .feed-body { min-width: 0; flex: 1; }
    .feed-item .feed-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .feed-item .feed-meta { font-size: 12px; color: var(--text-tertiary); margin-top: 1px; }

    /* ===== AVATAR (Avatar component pattern) ===== */
    .avatar-row {
      display: flex;
      gap: 4px;
    }
    .avatar-row .stack {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #8B5CF6, #EC4899);
      border: 2px solid var(--bg-primary);
      color: white;
      font-size: 11px;
      font-weight: 700;
      display: grid; place-items: center;
      margin-left: -8px;
    }
    .avatar-row .stack:first-child { margin-left: 0; }

    /* ===== BENTO ROW: ACTIONS + SIDEBAR FEED ===== */
    .bento-bottom {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    @media (min-width: 1024px) {
      .bento-bottom { flex-direction: row; }
    }
    .bento-bottom-main { display: flex; flex-direction: column; gap: 32px; flex: 1; }
    .bento-bottom-side { width: 100%; max-width: 280px; display: flex; flex-direction: column; gap: 16px; }

    /* ===== BENTO ROW: ACTION CARDS + ARTICLES ===== */
    .action-row {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 768px) {
      .action-row { flex-direction: row; gap: 24px; }
    }
    .article-row {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    @media (min-width: 768px) {
      .article-row { flex-direction: row; }
    }

    /* ===== CHART ===== */
    .area-chart-svg { width: 100%; height: 100%; }
    .grid-line { stroke: var(--utility-neutral-100); stroke-dasharray: 0; }

    /* UUI source attribution */
    .source-tag {
      position: fixed;
      bottom: 16px; right: 16px;
      background: var(--bg-primary);
      border: 1px solid var(--border-primary);
      border-radius: var(--r-md);
      padding: 8px 12px;
      box-shadow: var(--shadow-sm);
      font-size: 12px;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 100;
    }
    .source-tag .pill {
      background: var(--brand-50);
      color: var(--brand-700);
      padding: 2px 6px;
      border-radius: var(--r-sm);
      font-weight: 600;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* People avatar colors */
    .av-c1 { background: linear-gradient(135deg, #F59E0B, #DC2626); }
    .av-c2 { background: linear-gradient(135deg, #8B5CF6, #EC4899); }
    .av-c3 { background: linear-gradient(135deg, #10B981, #0D9488); }
    .av-c4 { background: linear-gradient(135deg, #3B82F6, #6366F1); }
    .av-c5 { background: linear-gradient(135deg, #EC4899, #F43F5E); }
    .av-c6 { background: linear-gradient(135deg, #14B8A6, #06B6D4); }
  </style>
</head>
