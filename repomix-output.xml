  }
  .fee-label .dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--amber);
    box-shadow: 0 0 0 3px var(--amber-soft);
  }
  .fee-value {
    font-family: var(--mono); font-size: 28px; font-weight: 600;
    letter-spacing: -0.02em; line-height: 1; color: var(--ink);
    margin-top: 8px; white-space: nowrap;
  }
  .fee-value .currency { font-size: 16px; color: var(--ink-4); margin-left: 3px; }
  .fee-rate {
    font-size: 12.5px; color: var(--ink-3); margin-top: 6px;
  }
  .fee-rate .rate-pill {
    display: inline-flex; align-items: center; gap: 4px;
    background: var(--amber-soft); color: var(--amber);
    padding: 2px 7px; border-radius: 5px;
    font-family: var(--mono); font-weight: 600; font-size: 11px;
    margin-right: 6px;
  }
  .fee-mini-grid {
    margin-top: 16px;
