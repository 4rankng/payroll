    queryKey: [...QueryKeys.settings.all, 'multiple', keys],
    queryFn: async () => {
      const allSettings = await settingsService.getSettings();
      return allSettings.filter(setting => keys.includes(setting.key));
    },
    enabled: keys.length > 0,
  });
};
