              className="min-h-11 gap-1.5 text-xs"
            >
              {page.cancelMutation.isPending ? "Đang hủy..." : "Hủy yêu cầu"}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </MobilePageShell>
  );
};

export default AdvancePaymentsPageMobile;
