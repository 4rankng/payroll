            <AlertDialogDescription className="text-xs">
              Yêu cầu sẽ được chuyển sang trạng thái đã hủy.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel className="min-h-11 text-xs" disabled={page.cancelMutation.isPending}>
