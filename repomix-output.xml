            {[
              { label: 'Tổng dự án', value: allProjects.length, icon: FolderKanban, tone: 'text-muted-foreground bg-muted' },
              { label: 'Đang hoạt động', value: activeCount, icon: CheckCircle2, tone: 'text-success bg-success/10' },
