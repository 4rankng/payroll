                }}
                onBlur={onSaveHourType}
                className={`h-11 p-2 text-xs font-mono font-semibold focus:ring-1 ${
                  editingHourTypeError
                    ? 'border border-destructive text-destructive bg-destructive/10 focus:ring-destructive'
