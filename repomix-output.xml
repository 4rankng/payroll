  .pipe-seg.pending { background: linear-gradient(180deg, #D89000 0%, #C58200 100%); }
  .pipe-seg.failed { background: linear-gradient(180deg, #D34D3F 0%, #C0382B 100%); }
  .pipe-seg.cancelled { background: linear-gradient(180deg, #6E7891 0%, #5B6478 100%); }
  .pipe-seg .seg-count { font-size: 14px; }
  .pipe-seg .seg-lbl { margin-left: 6px; font-weight: 500; opacity: 0.9; font-family: var(--display); font-size: 12.5px; }

  .pipe-meta {
    margin-top: 14px;
