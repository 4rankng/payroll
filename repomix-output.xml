  }
  .fee-mini .val {
    font-family: var(--mono); font-size: 14px; font-weight: 500; color: var(--ink); margin-top: 3px;
  }

  /* ---------- PIPELINE ---------- */
  .panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .pipeline { padding: 20px 24px 22px; }
  .pipeline-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 18px;
  }
  .panel-title {
    display: flex; align-items: center; gap: 12px;
