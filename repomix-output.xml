/**
 * Update loan metadata
 */
export const useUpdateLoan = () => {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: ({ id, data }: { id: number; data: UpdateLoanRequest }) =>
      loanService.updateLoan(id, data),
    onSuccess: async (response) => {
