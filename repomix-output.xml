		t.Fatalf("NewClient: %v", err)
	}
	if c.cfg.Endpoint != "https://mtf.onepay.vn" {
		t.Errorf("trailing slash not stripped: %q", c.cfg.Endpoint)
	}
}

// ---------------------------------------------------------------------------
