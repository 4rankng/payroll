<file path="frontend/src/styles/base.css">
/* ============================================================================
   BASE ELEMENT STYLES — HTML resets, body, typography classes, responsive overrides
   ============================================================================ */

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground;
    font-family: var(--font-family-sans);
    font-size: var(--text-base);
    font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  /* Full viewport height with PWA splash background */
  html {
    height: 100%;
    background-color: hsl(220 20% 98%);
  }

  body {
    min-height: 100%;
    min-height: 100dvh;
  }

  #root {
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* ========================================================================
     DISTINCTIVE TYPOGRAPHY - Breaking Anti-Patterns
     ======================================================================== */

  /* Display Headers - Manrope Bold, Confident */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-family-display);
    line-height: var(--leading-tight);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
  }

  h1 {
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
  }

  h2 {
    font-size: var(--text-4xl);
  }

  h3 {
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
  }

  h4 {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
  }

  /* ========================================================================
     TYPOGRAPHY UTILITY CLASSES - Material Design 3 Scale
     Used throughout the app for consistent text styling.
     These explicitly set font-family so they override the h* base rules above.
     ======================================================================== */

  /* Display — Manrope, for hero metrics and page titles */
  .typography-display-large {
    font-family: var(--font-family-display);
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .typography-display-medium {
    font-family: var(--font-family-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .typography-display-small {
    font-family: var(--font-family-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* Headline — Manrope, for section headers and sheet titles */
  .typography-headline-large {
    font-family: var(--font-family-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }
  .typography-headline-medium {
    font-family: var(--font-family-display);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }
  .typography-headline-small {
    font-family: var(--font-family-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  /* Title — Inter (body font), for card titles and list items */
  .typography-title-large {
    font-family: var(--font-family-sans);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }
  .typography-title-medium {
    font-family: var(--font-family-sans);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }
  .typography-title-small {
    font-family: var(--font-family-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  /* Body — Inter, for content text */
  .typography-body-large {
    font-family: var(--font-family-sans);
    font-size: var(--text-base);
    font-weight: var(--font-normal);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-normal);
  }
  .typography-body-medium {
    font-family: var(--font-family-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-normal);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }
  .typography-body-small {
    font-family: var(--font-family-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  /* Label — Inter, for badges, tags, and metadata */
  .typography-label-large {
    font-family: var(--font-family-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wide);
  }
  .typography-label-medium {
    font-family: var(--font-family-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wide);
  }
  .typography-label-small {
    font-family: var(--font-family-sans);
    font-size: 0.625rem; /* 10px */
    font-weight: var(--font-medium);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wider);
  }

  /* ========================================================================
     SEMANTIC TYPOGRAPHY ROLES
     Prefer these for new UI so font size follows hierarchy, not local taste.
     ======================================================================== */
  .type-page-title {
    font-family: var(--font-family-display);
    font-size: var(--type-page-title);
    font-weight: var(--font-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-normal);
  }

  .type-section-title {
    font-family: var(--font-family-display);
    font-size: var(--type-section-title);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .type-card-title {
    font-family: var(--font-family-display);
    font-size: var(--type-card-title);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .type-body {
    font-family: var(--font-family-sans);
    font-size: var(--type-body);
    font-weight: var(--font-normal);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-normal);
  }

  .type-body-strong {
    font-family: var(--font-family-sans);
    font-size: var(--type-body);
    font-weight: var(--font-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  .type-body-sm {
    font-family: var(--font-family-sans);
    font-size: var(--type-body-sm);
    font-weight: var(--font-normal);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  .type-label {
    font-family: var(--font-family-sans);
    font-size: var(--type-label);
    font-weight: var(--font-semibold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wide);
  }

  .type-label-caps {
    font-family: var(--font-family-sans);
    font-size: var(--type-label);
    font-weight: var(--font-semibold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .type-caption {
    font-family: var(--font-family-sans);
    font-size: var(--type-caption);
    font-weight: var(--font-medium);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  .type-count-badge {
    font-family: var(--font-family-sans);
    font-size: var(--type-count-badge);
    font-weight: var(--font-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-normal);
  }

  .type-action {
    font-family: var(--font-family-sans);
    font-size: var(--type-body);
    font-weight: var(--font-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-normal);
  }

  .type-metric-sm,
  .type-metric-md,
  .type-metric-lg,
  .type-metric-xl {
    font-family: var(--font-family-display);
    font-weight: var(--font-extrabold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-normal);
  }

  .type-metric-sm {
    font-size: var(--type-metric-sm);
  }

  .type-metric-md {
    font-size: var(--type-metric-md);
  }

  .type-metric-lg {
    font-size: var(--type-metric-lg);
  }

  .type-metric-xl {
    font-size: var(--type-metric-xl);
  }

  /* Mobile typography adjustment */
  @media (max-width: 640px) {
    html {
      font-size: 16px;
    }

    h1 {
      font-size: var(--text-3xl);
    }

    h2 {
      font-size: var(--text-2xl);
    }

    h3 {
      font-size: var(--text-xl);
    }

    h4 {
      font-size: var(--text-lg);
    }
  }

  /* Employee-owned component primitives. They mirror daisyUI's card/button
     composition without inheriting the admin-only daisyUI theme root. */
  .employee-surface-card {
    border: 1px solid var(--employee-border);
    border-radius: var(--employee-radius-card);
    background: var(--employee-surface);
    box-shadow: none;
  }

  .employee-fintech-surface {
    position: relative;
    background: var(--employee-surface);
  }

  .employee-fintech-surface[data-period-state] {
    background: var(--employee-surface);
  }

  .employee-fintech-surface[data-period-state="open"] {
    background: var(--employee-accent-soft);
  }

  .employee-icon-button {
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--employee-border);
    border-radius: var(--employee-radius-control);
    background: var(--employee-surface);
    color: var(--employee-text-secondary);
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .employee-icon-button:active {
    border-color: var(--employee-accent-border);
    background: var(--employee-accent-soft);
    color: var(--employee-accent);
  }

  .employee-icon-button:focus-visible {
    outline: 2px solid var(--employee-focus-ring);
    outline-offset: 2px;
  }

  .employee-mobile-page[data-has-action-toolbar="true"] {
    --employee-action-toolbar-block-size: 5.5rem;
  }

  .employee-mobile-page {
    background-color: var(--employee-page);
  }

  /* ========================================================================
     MOBILE PAGE STYLES - Touch-friendly, safe-area-aware
     ======================================================================== */
  .mobile-page {
    --mobile-safe-top: env(safe-area-inset-top, 0px);
    --mobile-safe-bottom: env(safe-area-inset-bottom, 0px);
    --mobile-header-top-padding: calc(var(--mobile-safe-top) + 1rem);
    --mobile-page-top-padding: calc(var(--mobile-safe-top) + 0.75rem);
    --mobile-page-bottom-padding: calc(5.75rem + var(--mobile-safe-bottom));
    padding-bottom: calc(56px + env(safe-area-inset-bottom, 0px));
    -webkit-overflow-scrolling: touch;
  }

  .mobile-page button,
  .mobile-page a,
  .mobile-page [role="button"] {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-main-content {
    max-width: 100%;
    overflow-x: clip;
    overflow-y: visible;
  }

  @media (max-width: 1023px) {
    .mobile-main-content {
      scroll-padding-bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px));
    }

    .mobile-main-content button,
    .mobile-main-content a,
    .mobile-main-content [role="button"] {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
  }

  /* ========================================================================
     SCROLLBAR STYLES - Subtle Professional Feel
     ======================================================================== */

  /* Thin scrollbar for Webkit browsers */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--muted-foreground) / 0.2);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: content-box;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--muted-foreground) / 0.35);
    background-clip: content-box;
  }

  /* Firefox scrollbar */
  * {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.2) transparent;
  }

  /* ========================================================================
     FOCUS VISIBLE - Accessible, Professional
     ======================================================================== */
  :focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ========================================================================
     SMOOTH TRANSITIONS - Global Default
     ======================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
}

@layer components {
  @media (max-width: 640px) {
    .employee-mobile-page {
      font-size: 16px;
      line-height: 1.5;
      text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
      color: var(--employee-text);
      background: var(--employee-page);
    }

    .employee-mobile-page h1,
    .employee-mobile-page h2,
    .employee-mobile-page h3 {
      letter-spacing: 0;
    }

    .employee-mobile-page button,
    .employee-mobile-page [role="button"] {
      min-height: 44px;
    }
  }

  /* Weight ladder (employee portal): 400 body/descriptions → 500 labels →
     600 titles, values, actions, badges → 700 reserved for the primary money
     figure. The hierarchy comes from role, spacing, and contrast—not boldness. */
  .employee-type-header-greeting {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-caption);
    font-weight: var(--font-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-header-name {
    font-family: var(--font-family-display);
    font-size: 1.375rem;
    font-weight: var(--font-semibold);
    line-height: 1.75rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-header-date {
    font-family: var(--font-family-sans);
    font-size: 0.8125rem;
    font-weight: var(--font-normal);
    line-height: 1.125rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-hero-title {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-title);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-section-title {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-title);
    font-weight: var(--font-semibold);
    line-height: 1.5rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-card-title {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-strong);
    font-weight: var(--font-semibold);
    line-height: 1.375rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-month-title {
    font-family: var(--font-family-display);
    font-size: 1.0625rem;
    font-weight: var(--font-semibold);
    line-height: 1.5rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-hero-amount {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-money);
    font-weight: var(--font-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-confirm-amount {
    font-family: var(--font-family-display);
    font-size: 1.5rem;
    font-weight: var(--font-semibold);
    line-height: 1.875rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-card-amount {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-title);
    font-weight: var(--font-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-row-amount {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-strong);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-bank-value {
    font-family: var(--font-family-display);
    font-size: 0.9375rem;
    font-weight: var(--font-semibold);
    line-height: 1.375rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-bank-label {
    font-family: var(--font-family-sans);
    font-size: 0.8125rem;
    font-weight: var(--font-normal);
    line-height: 1.1875rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-payroll-value {
    font-family: var(--font-family-display);
    font-size: 0.9375rem;
    font-weight: var(--font-semibold);
    line-height: 1.375rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-payroll-label {
    font-family: var(--font-family-sans);
    font-size: 0.8125rem;
    font-weight: var(--font-normal);
    line-height: 1.125rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-warning-title {
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: var(--font-semibold);
    line-height: 1.3125rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-notification-badge {
    font-family: var(--font-family-sans);
    font-size: 0.6875rem;
    font-weight: var(--font-bold);
    line-height: 0.875rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-inline-amount {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-strong);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-large-row-amount {
    font-family: var(--font-family-display);
    font-size: var(--employee-type-title);
    font-weight: var(--font-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-label {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-label);
    font-weight: var(--font-medium);
    line-height: 1.125rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-label-caps {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-caption);
    font-weight: var(--font-semibold);
    line-height: 1.0625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .employee-type-body {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-body);
    font-weight: var(--font-normal);
    line-height: 1.3125rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-body-sm {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-body-sm);
    font-weight: var(--font-normal);
    line-height: 1.1875rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-strong {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-strong);
    font-weight: var(--font-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-pill {
    font-family: var(--font-family-sans);
    font-size: var(--employee-type-caption);
    font-weight: var(--font-semibold);
    line-height: 1.0625rem;
    letter-spacing: var(--tracking-normal);
  }

  .employee-type-action {
    font-family: var(--font-family-sans);
    font-size: 0.875rem;
    font-weight: var(--font-semibold);
    line-height: 1.25rem;
    letter-spacing: var(--tracking-normal);
  }

  @media (max-width: 640px) {
    .employee-mobile-page {
      --employee-mobile-caption: 0.75rem;      /* 12px: metadata/counters */
      --employee-mobile-label: 0.8125rem;      /* 13px: field labels */
      --employee-mobile-body-sm: 0.8125rem;    /* 13px: secondary copy */
      --employee-mobile-body: 0.875rem;        /* 14px: body text */
      --employee-mobile-title-sm: 1rem;        /* 16px: card titles */
      --employee-mobile-section-title: 1.125rem; /* 18px: section titles */
      --employee-mobile-header-name: 1.375rem; /* 22px: employee name */
      --employee-mobile-amount-sm: 0.9375rem;  /* 15px: row money values */
      --employee-mobile-amount-md: 0.9375rem;  /* 15px: bank/inline values */
      --employee-mobile-amount-lg: 1rem;       /* 16px: record primary money */
      --employee-mobile-amount-xl: 2rem;       /* 32px: primary available amount */
    }

    .employee-mobile-page .employee-type-header-greeting,
    .employee-mobile-page .employee-type-label-caps,
    .employee-mobile-page .employee-type-pill {
      font-size: var(--employee-mobile-caption);
    }

    .employee-mobile-page .employee-type-label {
      font-size: var(--employee-mobile-label);
    }

    .employee-mobile-page .employee-type-body-sm {
      font-size: var(--employee-mobile-body-sm);
    }

    .employee-mobile-page .employee-type-body {
      font-size: var(--employee-mobile-body);
    }

    .employee-mobile-page .employee-type-action {
      font-size: 0.875rem;
    }

    .employee-mobile-page .employee-type-card-title {
      font-size: var(--employee-mobile-title-sm);
      line-height: 1.375rem;
    }

    .employee-mobile-page .employee-type-header-name {
      font-size: var(--employee-mobile-header-name);
      line-height: 1.75rem;
    }

    .employee-mobile-page .employee-type-hero-title,
    .employee-mobile-page .employee-type-section-title {
      font-size: var(--employee-mobile-section-title);
      line-height: 1.5rem;
    }

    .employee-mobile-page .employee-type-row-amount {
      font-size: var(--employee-mobile-amount-sm);
      line-height: 1.375rem;
    }

    .employee-mobile-page .employee-type-bank-value,
    .employee-mobile-page .employee-type-inline-amount {
      font-size: var(--employee-mobile-amount-md);
      line-height: 1.375rem;
    }

    .employee-mobile-page .employee-type-card-amount,
    .employee-mobile-page .employee-type-large-row-amount {
      font-size: var(--employee-mobile-amount-lg);
      line-height: 1.15;
    }

    .employee-mobile-page .employee-type-hero-amount {
      font-size: var(--employee-mobile-amount-xl);
      line-height: 2.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .employee-mobile-page *,
    .employee-mobile-page *::before,
    .employee-mobile-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .employee-notification-pop {
      animation: employee-notification-pop 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .employee-advance-request-confirm {
      animation: employee-advance-request-confirm 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes employee-notification-pop {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    70% {
      opacity: 1;
      transform: scale(1.08);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes employee-advance-request-confirm {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

}

/* ─── Check-in button micro-animations ─────────────────────────────────── */
/* GPS-warming pulse: gentle breathing while acquiring a fix. */
@keyframes check-in-warming {
  0%, 100% { opacity: 0.72; }
  50% { opacity: 1; }
}
.check-in-warming { animation: check-in-warming 1.8s ease-in-out infinite; }

/* Became-ready emphasis: flat opacity transition when GPS stabilizes. */
@keyframes check-in-ready-pop {
  0% { opacity: 0.6; }
  100% { opacity: 1; }
}
.check-in-ready-pop { animation: check-in-ready-pop 0.25s ease-out; }

/* Outside-window hint fade-in. */
@keyframes check-in-hint-fade {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
.check-in-hint-fade { animation: check-in-hint-fade 0.3s ease-out; }

@keyframes attendance-gates-reveal {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.attendance-gates-reveal { animation: attendance-gates-reveal 0.22s ease-out; }

@keyframes attendance-action-confirm {
  from { opacity: 0; transform: translateY(6px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.attendance-action-confirm,
.attendance-window-open { animation: attendance-action-confirm 0.28s ease-out; }

@keyframes gps-accuracy-confirmed {
  0% { transform: scale(0.88); opacity: 0.6; }
  65% { transform: scale(1.07); opacity: 1; }
  100% { transform: scale(1); }
}
.gps-accuracy-confirmed { animation: gps-accuracy-confirmed 0.35s ease-out; }

@keyframes checkpoint-route-reveal {
  from { stroke-dashoffset: 28; opacity: 0.25; }
  to { stroke-dashoffset: 0; opacity: 1; }
}
.checkpoint-route-reveal { animation: checkpoint-route-reveal 0.35s ease-out; }
.checkpoint-direction-arrow-marker {
  background: transparent;
  border: 0;
  transition: opacity 0.16s ease;
  will-change: transform, opacity;
}
.checkpoint-direction-arrow {
  display: block;
  width: 20px;
  height: 24px;
  transform-origin: 50% 50%;
}
@keyframes checkpoint-marker-emphasis {
  0%, 100% { stroke-width: 3; }
  50% { stroke-width: 7; }
}
.checkpoint-marker-emphasis { animation: checkpoint-marker-emphasis 0.45s ease-out; }

@media (prefers-reduced-motion: reduce) {
  .check-in-warming,
  .check-in-ready-pop,
  .check-in-hint-fade {
    animation: none;
  }
  .attendance-action-confirm,
  .attendance-window-open,
  .gps-accuracy-confirmed,
  .checkpoint-route-reveal,
  .checkpoint-marker-emphasis { animation: none; }
}
