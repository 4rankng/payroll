		Notification: NotificationConfig{
			EmailEnabled:      true,
			DefaultRecipients: []string{},
			DefaultCC:         []string{},
			DefaultBCC:        []string{},
			ResendAPIKey:      getEnv("RESEND_API_KEY", ""),
			SendTimeout:       5 * time.Second,
			VAPIDPublicKey:    getEnv("VAPID_PUBLIC_KEY", ""),
