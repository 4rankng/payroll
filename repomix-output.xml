func TestGetUserIDOrRespond(t *testing.T) {
	gin.SetMode(gin.TestMode)

	tests := []struct {
		name           string
		setupCtx       func(*gin.Context)
		expectedID     uint
		expectedOK     bool
		expectResponse bool
	}{
		{
			name: "valid user ID",
			setupCtx: func(c *gin.Context) {
				c.Set(constants.CtxUserID, uint(123))
			},
			expectedID:     123,
			expectedOK:     true,
			expectResponse: false,
		},
		{
