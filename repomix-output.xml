                            <span className="typography-label-small text-primary">Thành tiền</span>
                          </div>
                          <p className="typography-title-medium font-bold text-primary tabular-nums">
                            {formatCurrency(group.totalAmount)}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Expanded Content */}
