  3: 'grid-cols-1 min-[380px]:grid-cols-2 sm:grid-cols-3',
  4: 'grid-cols-1 min-[380px]:grid-cols-2 sm:grid-cols-4',
};

export const StatsCards = ({ stats, columns = 4 }: StatsCardsProps) => (
  <div
    data-slot="stats-cards"
