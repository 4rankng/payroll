      queryClient.invalidateQueries({
        queryKey: QueryKeys.advancePayments.admin.feeSchedules,
      });
      showSuccessNotification(response.message ?? "Đã xóa cấu hình phí");
    },
    onError: (error) => {
      showErrorNotification(error);
    },
