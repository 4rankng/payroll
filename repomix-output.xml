<file path="frontend/src/styles/variables.css">
/* ============================================================================
   CSS CUSTOM PROPERTIES — Design Tokens
   Colors, shadows, typography, spacing, gradients
   ============================================================================ */

@layer base {
  :root {
    /* ========================================================================
       TINGTING EMERALD PRODUCT PALETTE
       Shared by login, employee, partner, and admin experiences.
       ======================================================================== */

    /* Primary - TingTing Emerald */
    --primary: 151 87% 25%;           /* #08783e */
    --primary-foreground: 0 0% 100%;  /* Pure white for contrast */

    /* Success - Professional Green (Positive, Achievement, Growth) */
    --success: 142 71% 45%;            /* Rich emerald green */
    --success-foreground: 142 100% 10%; /* Dark green for readability */

    /* Warning - Amber Warmth (Attention, Energy, Alert) */
    --warning: 35 90% 60%;            /* #e8973b - Warm amber */

    /* Info - Teal Professional (Clarity, Communication, Trust) */
    --info: 180 70% 45%;              /* #2a9d8f - Calming teal */

    /* Destructive - Confident Red (Critical Actions, Errors) */
    --destructive: 0 84% 60%;         /* #e53e3e - Clear, urgent */
    --destructive-foreground: 0 0% 100%;

    /* Background System - Warm, Premium Whites */
