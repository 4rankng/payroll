			Timezone:                 getEnv("SCHEDULER_TIMEZONE", "Asia/Ho_Chi_Minh"),
			TimesheetReminderEnabled: parseBool(getEnv("TIMESHEET_REMINDER_ENABLED", "true")),
			PayrollReminderEnabled:   parseBool(getEnv("PAYROLL_REMINDER_ENABLED", "true")),
