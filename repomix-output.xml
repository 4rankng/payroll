            onAddEmployee={() => openAddEmployee()}
          />
        ) : (
          <>
            <div className="space-y-2">
              {employees.map((employee) => (
                <EmployeeMobileCard
                  key={employee.id}
                  employee={employee}
                  onClick={handleEmployeeClick}
                />
              ))}
            </div>
            {hasMore && (
              <div className="flex justify-center py-4">
                <Button
                  variant="outline"
                  size="sm"
                  className="gap-2"
