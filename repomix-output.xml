<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --font: 'Geist', system-ui, sans-serif;
  --bg-page:     #F2F3F5;
  --bg-card:     #FFFFFF;
  --bg-header:   #FAFBFC;
  --bg-row-sat:  #FFFBF0;
  --bg-row-sun:  #FFF5F5;
  --bg-row-hover:#F8F9FB;

  --border:      #E4E6EB;
  --border-soft: #ECEEF2;

  --text-primary:   #111827;
  --text-secondary: #5A6478;
  --text-muted:     #96A0B5;

  --blue:        #2563EB;
  --blue-light:  #EEF3FD;
  --blue-mid:    #DBEAFE;
  --green:       #16A34A;
  --green-light: #F0FDF4;
  --sat-color:   #B45309;
  --sat-bg:      #FEF3C7;
  --sun-color:   #B91C1C;
  --sun-bg:      #FEE2E2;
  --wd-color:    #374151;
  --wd-bg:       #F1F5F9;

  --radius-sm:  4px;
  --radius-md:  8px;
  --radius-lg:  12px;
  --radius-xl:  16px;

  --shadow-card: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --shadow-modal: 0 20px 60px rgba(0,0,0,.18), 0 4px 16px rgba(0,0,0,.08);
}

body {
  font-family: var(--font);
  background: #DDE1E7;
  min-height: 100vh;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 32px 16px 64px;
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
}

/* ── Modal shell ── */
.modal {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  width: 100%;
  max-width: 1100px;
  box-shadow: var(--shadow-modal);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 64px);
}

/* ── Header ── */
.modal-header {
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--border);
  background: var(--bg-header);
  flex-shrink: 0;
}

.header-title {
  display: flex;
  align-items: center;
  padding: 0 20px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  border-right: 1px solid var(--border);
  white-space: nowrap;
  height: 44px;
}

.filter-pill {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 0 14px;
