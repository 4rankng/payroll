					EntityType:   domain.EntityTypeUser,
				},
				Success: false,
				Reason:  reason,
			}

			if err := handler.Handle(context.Background(), event); err != nil {
				return false
			}

			if len(enqueuer.payloads) != 1 {
				return false
			}

			p := enqueuer.payloads[0]
			if p.MetadataJSON == "" {
				return false
			}

