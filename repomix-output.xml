  ];

  const ROLES = {
    staff: { cls:'role-staff', label:'Nhân viên' },
    mgr:   { cls:'role-mgr',   label:'Quản lý' },
    acc:   { cls:'role-acc',   label:'Kế toán' },
    admin: { cls:'role-admin', label:'Quản trị' },
  };

  function activityCell(r) {
    if (!r.activity) {
      return `<div class="activity never">
                <span class="dot never"></span>
                <span class="when">Chưa đăng nhập</span>
              </div>`;
    }
    let dotCls = 'stale';
    if (r.live) dotCls = 'live';
    else if (r.ago && r.ago.includes('2 ngày')) dotCls = 'recent';
    return `<div class="activity">
              <span class="dot ${dotCls}"></span>
              <div style="display:flex; flex-direction:column; line-height:1.3;">
                <span class="when">${r.activity}</span>
                ${r.ago ? `<span class="ago">${r.ago}</span>` : ''}
              </div>
            </div>`;
  }

  function rowHTML(r, i) {
    const role = ROLES[r.role];
    return `
      <tr data-idx="${i}">
        <td class="col-check">
          <div class="check" onclick="toggleRow(${i}, event)">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </td>
        <td class="col-idx">${String(i+1).padStart(2,'0')}</td>
        <td>
          <div class="user-cell">
            <div class="ava ${r.avaClass} ${r.online ? 'online' : ''}">${r.initial}</div>
            <div class="id">
              <strong>${r.name}</strong>
              <span>@${r.handle}</span>
            </div>
          </div>
        </td>
        <td>
          <span class="role ${role.cls}">
            <span class="pin"></span>${role.label}
          </span>
        </td>
        <td>${activityCell(r)}</td>
        <td class="date-cell">${r.created}</td>
        <td>
          <div class="row-actions">
            <button class="ra" title="Xem chi tiết">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <button class="ra" title="Chỉnh sửa">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <button class="ra danger" title="Vô hiệu hóa">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/></svg>
            </button>
          </div>
        </td>
      </tr>`;
  }

  const tbody = document.getElementById('tbody');
  tbody.innerHTML = ROWS.map(rowHTML).join('');

  // Selection
  const selected = new Set();
  function refreshBulk() {
    const bar = document.getElementById('bulkBar');
    document.getElementById('bulkCount').textContent = selected.size;
    bar.classList.toggle('show', selected.size > 0);
    const all = document.getElementById('check-all');
    all.classList.toggle('on', selected.size === ROWS.length);
  }
  function toggleRow(i, ev) {
    if (ev) ev.stopPropagation();
    const tr = document.querySelector(`tr[data-idx="${i}"]`);
    const chk = tr.querySelector('.check');
    if (selected.has(i)) { selected.delete(i); chk.classList.remove('on'); tr.classList.remove('checked'); }
    else { selected.add(i); chk.classList.add('on'); tr.classList.add('checked'); }
    refreshBulk();
  }
  function toggleAll() {
    if (selected.size === ROWS.length) clearAll();
    else {
      ROWS.forEach((_, i) => {
        selected.add(i);
        const tr = document.querySelector(`tr[data-idx="${i}"]`);
        tr.querySelector('.check').classList.add('on');
        tr.classList.add('checked');
      });
      refreshBulk();
    }
  }
  function clearAll() {
    selected.clear();
    document.querySelectorAll('.check.on').forEach(c => c.classList.remove('on'));
    document.querySelectorAll('tr.checked').forEach(t => t.classList.remove('checked'));
    refreshBulk();
  }

  // Filter chip toggles (visual only)
  document.querySelectorAll('.chips .chip').forEach(c => {
    c.addEventListener('click', () => {
      document.querySelectorAll('.chips .chip').forEach(x => x.classList.remove('on'));
      c.classList.add('on');
    });
  });
</script>

</body>
</html>
