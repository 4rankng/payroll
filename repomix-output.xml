  /* Hide nhân viên view by default */
  .view-employees { display: none; }
  body.view-employees-active .view-requests { display: none; }
  body.view-employees-active .view-employees { display: block; }
  body.view-employees-active .filter-chips { display: none; }
  body.view-employees-active .month-filter { display: inline-flex; }

  .month-filter {
