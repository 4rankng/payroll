            <SheetClose asChild>
              <Button
                variant="ghost"
                size="icon"
                className="h-8 w-8 rounded-full shrink-0 text-muted-foreground hover:text-foreground"
                aria-label="Đóng"
              >
                <X className="h-4 w-4" />
              </Button>
            </SheetClose>
          </div>
