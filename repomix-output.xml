      <div className="mt-2.5 h-1.5 overflow-hidden rounded-full bg-muted" aria-hidden="true">
        <div
          className="h-full rounded-full"
          style={{ width: `${item.percentage}%`, backgroundColor: item.color }}
        />
      </div>
    </li>
