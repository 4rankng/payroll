<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quản lý ứng lương · TingTing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F6F7F9;
    --surface: #FFFFFF;
    --surface-muted: #FAFBFC;
    --border: #E8EAEE;
    --border-strong: #D9DCE2;
    --text: #0B1729;
    --text-secondary: #475467;
    --text-tertiary: #8A92A6;
    --text-muted: #B0B5C2;

    --nav-bg: #0B1729;
    --nav-bg-hover: #142238;
    --nav-bg-active: #1B2D49;
    --nav-text: #8995AC;
    --nav-text-active: #FFFFFF;
    --nav-border: #1B2740;

    --hero-bg: #0E1A2F;
    --hero-bg-2: #15243F;
    --hero-text: #FFFFFF;
    --hero-text-muted: #8A9BBD;

    --accent: #00B07C;
    --accent-soft: #E6F7F1;

    --green: #15803D;
    --green-soft: #E7F6EC;
    --amber: #B45309;
    --amber-soft: #FEF3C7;
    --red: #B91C1C;
    --red-soft: #FEE7E7;
    --slate: #475569;
    --slate-soft: #EEF1F5;
    --blue: #1D4ED8;
    --blue-soft: #E7EEFC;

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 18px;

    --shadow-xs: 0 1px 2px rgba(11, 23, 41, 0.04);
    --shadow-sm: 0 1px 3px rgba(11, 23, 41, 0.06), 0 1px 2px rgba(11, 23, 41, 0.04);
    --shadow-md: 0 4px 12px rgba(11, 23, 41, 0.06), 0 2px 4px rgba(11, 23, 41, 0.04);

    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input { font-family: inherit; border: none; outline: none; }

  /* ───── Layout ───── */
  .app {
    display: grid;
    grid-template-columns: 248px 1fr;
    min-height: 100vh;
  }

  /* ───── Sidebar ───── */
  .sidebar {
    background: var(--nav-bg);
    color: var(--nav-text);
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--nav-border);
  }

  .brand {
    padding: 22px 24px 26px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--nav-border);
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, #00B07C 0%, #00876B 100%);
    display: grid;
    place-items: center;
    font-weight: 800;
    color: white;
    font-size: 14px;
    letter-spacing: -0.02em;
  }

  .brand-name {
    font-weight: 800;
    font-size: 18px;
    color: white;
    letter-spacing: -0.02em;
  }
  .brand-name span { color: #00B07C; }

  .nav-section {
    padding: 22px 16px 8px;
  }

  .nav-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #5E6A82;
    text-transform: uppercase;
    padding: 0 12px 10px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    margin: 2px 0;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--nav-text);
    width: 100%;
    text-align: left;
    transition: background 0.15s, color 0.15s;
    position: relative;
  }
  .nav-item:hover { background: var(--nav-bg-hover); color: white; }
  .nav-item.active {
    background: var(--nav-bg-active);
    color: var(--nav-text-active);
    font-weight: 600;
  }
  .nav-item.active::before {
