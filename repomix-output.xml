		AssetID:        assetID,
		Filename:       filename,
		TotalTransfers: totalTransfers,
		CompletedCount: completedCount,
		FailedCount:    failedCount,
		TotalAmount:    totalAmount,
		IsDuplicate:    isDuplicate,
	}
}

