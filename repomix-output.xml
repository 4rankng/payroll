          <MobileBottomNav
            groups={isAdvPartner ? ADV_PARTNER_NAV_GROUPS : ADMIN_NAV_GROUPS}
            moreItems={isAdvPartner ? undefined : ADMIN_MORE_ITEMS}
          />
          <NotificationFAB />
        </div>
      </SidebarProvider>
    </ProtectedRoute>
  );
};

