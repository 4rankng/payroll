		response.BadRequest(c, constants.MsgInvalidQueryParametersVN)
		return
	}

	userIDVal, exists := c.Get(constants.CtxUserID)
	if !exists {
		response.Forbidden(c, "Không tìm thấy thông tin người dùng")
		return
