          (() => {
            const emp = employee;
            const usedPct =
              emp.maxAdvanceAmount > 0
                ? Math.round(
                    (emp.utilizedAmount / emp.maxAdvanceAmount) * 100,
                  )
                : 0;
            const requests = (employeeRequests?.data ??
              []) as AdvancePaymentListItem[];

            return (
              <>
                <MobileSheetHeader
                  icon={Users}
