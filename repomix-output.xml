	rows, skipped, txnCodes, err := e.buildRowsWithSwift(context.Background(), data, "weekly", time.Date(2026, 7, 1, 0, 0, 0, 0, time.UTC), time.Date(2026, 7, 7, 0, 0, 0, 0, time.UTC))
