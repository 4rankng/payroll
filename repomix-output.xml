import { CheckCircle2, XCircle, Loader2 } from "lucide-react";

export const STATUS_META = {
  success: {
    icon: CheckCircle2,
    color: "text-emerald-500",
    bg: "bg-emerald-50",
    border: "border-emerald-200",
    label: "Thành công",
