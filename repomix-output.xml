            : "flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
        }
      >
        <main
          id="main-content"
          className={
            isMobile
              ? "admin-main min-h-dvh flex-1 overflow-visible"
              : "admin-main min-h-0 flex-1 overflow-auto"
