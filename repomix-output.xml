		"- Dòng 3: Nhân viên nghỉ, để trống 'Loại ngày' hoặc nhập 0 vào các cột ca"

	if err := f.SetCellValue(sheetName, fmt.Sprintf("A%d", currentRow), exampleText); err != nil {
