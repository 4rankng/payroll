		batchRepo: batchRepo,
		paymentRepo: &bookingPaymentReader{rows: []*domaintx.WalletPayment{
			{ID: 1, RequestID: "VFICa", RequestedAmount: 1_192_500, Status: domaintx.StateCompleted},
		}},
