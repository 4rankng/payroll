	// Query without any explicit filter - should exclude deleted records
	var results []TestInactiveModel
	db.Find(&results)

	assert.Equal(t, 2, len(results))
	for _, result := range results {
		assert.NotEqual(t, "deleted", result.IsActive)
	}
