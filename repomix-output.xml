		t.Fatalf("checkout start = %s, want %s", got, want)
	}
	if got, want := checkOutEnd.Format("2006-01-02 15:04"), "2026-06-22 08:00"; got != want {
		t.Fatalf("checkout end = %s, want %s", got, want)
	}
