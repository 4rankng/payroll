  }, [loan]);

  const scheduleList = useMemo(() => {
    if (!loan) {
      return null;
    }

    const schedulesToDisplay =
      loan.schedules && loan.schedules.length > 0
        ? loan.schedules
        : fallbackSchedule;

    if (schedulesToDisplay.length === 0) {
      return (
        <div className="text-muted-foreground typography-body-small">
