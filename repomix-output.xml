  icon: LucideIcon;
  description?: string;
  change?: string;
  trend?: 'up' | 'down' | 'neutral';
  color?: 'blue' | 'green' | 'red' | 'yellow' | 'purple' | 'gray';
}

interface StatsCardsProps {
  stats: StatCardData[];
  columns?: 1 | 2 | 3 | 4;
}

const COLOR_MAP: Record<string, 'blue' | 'emerald' | 'amber' | 'teal' | 'rose'> = {
  blue: 'blue',
  green: 'emerald',
  red: 'rose',
  yellow: 'amber',
  purple: 'teal',
  gray: 'blue',
};

const gridColsMap: Record<number, string> = {
  1: 'grid-cols-1',
