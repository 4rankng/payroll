  return useMutation({
    mutationFn: ({ id, data }: { id: number; data: UpdateSettingData }) =>
      settingsService.updateSetting(id, data),
    onSuccess: (response) => {
      // Invalidate all settings queries to refresh
      queryClient.invalidateQueries({ queryKey: QueryKeys.settings.all });

