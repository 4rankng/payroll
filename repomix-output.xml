	if len(parts) != 2 {
		return "", "", false
	}

	employeeName := strings.TrimSpace(parts[0])
	projectName := strings.TrimSpace(parts[1])
	if employeeName == "" || projectName == "" {
		return "", "", false
	}

	return employeeName, projectName, true
}

