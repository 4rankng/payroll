    {
      "id": "claim_b121d75e72a74e79bff60aed9ea384c7",
      "statement": "The backend follows strict DDD layering with dependencies pointing inward (transport → app → domain ← infra); the domain package has zero framework imports — no Gin, no GORM, only the Go standard library and internal packages.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/ADR-001-ddd-clean-architecture.md#L14-L34",
          "version": "repo-lines-v1:sha256:627156757d56fea3bd259d344bdc7419f227c8760db5de9be09b2adb222f96e5:"
        }
      ]
    },
    {
      "id": "claim_0293d4679e514f348438ac52bffcad25",
      "statement": "A single HTTP request traverses a fixed middleware chain in order: security headers, request timeout, rate limit, JWT auth, Casbin RBAC authorization, audit context, and partner scoping — before reaching the handler.",
      "evidence": [
        {
          "resource": "repo://docs/system-architecture.md#L72-L80",
          "version": "repo-lines-v1:sha256:98667ec8e1c85e0f8cea2f938f516be467e7ebba820036877b209dedba1bb266:"
        }
      ]
    },
    {
