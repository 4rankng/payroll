          "version": "repo-lines-v1:sha256:4226a6dfa5caa390d3131cef912d9c34a0d451f7112f435713614c1339910d99:"
        }
      ]
    },
    {
      "id": "claim_6c96fca4e71d4a638ff158ec9ff2e81d",
      "statement": "The forecast covers only the target Kỳ: observed approved value already inside the cycle plus projected approvals still expected before the pay date. Outstanding payments from other cycles belong to the operational Chờ thanh toán KPI and never enter the forecast input.",
