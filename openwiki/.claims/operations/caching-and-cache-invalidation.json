  "claims": [
    {
      "id": "claim_e664d3f2d7f34451be81166d19496edd",
      "statement": "Cache invalidation must run after WithTransaction returns successfully, never inside it — invalidating mid-transaction lets a concurrent reader repopulate the cache with pre-commit data that becomes phantom state on rollback; domain.RegisterAfterCommit is the canonical hook for service code, and the event-driven cache_invalidation_handler enforces the invariant structurally because events are published strictly post-commit.",
      "evidence": [
        {
          "resource": "repo://backend/internal/domain/transaction_manager.go#L30-L49",
          "version": "repo-lines-v1:sha256:39d3950d254300b58141d1f9aca7566cb89dfd9457e833f93dd7308b9ca66133:"
        },
        {
          "resource": "repo://docs/decisions/ADR-007-transaction-manager-unit-of-work.md#L38-L52",
          "version": "repo-lines-v1:sha256:227efbcb4ac43ca5b58d39db8d97cdb9a0e2a5e373ca839df395a91cc1da4a79:"
        }
      ]
    },
    {
      "id": "claim_b18d348be4b3489cb1de33ce211200b8",
      "statement": "All cache access goes through the domain.CacheServiceUseCase interface (Get, Set, Delete, DeletePattern, Exists, FlushAll, GetRedisStats) with centralized key generation helpers (GenerateBankCacheKey, GenerateSettingsCacheKey, GenerateTransactionCacheKey, GenerateTimesheetCacheKey, GenerateDashboardCacheKey); security tokens (OIDC nonces, OTP pending sessions, password reset, Zalo OA reset) use dedicated stores in backend/internal/infra/cache/ rather than the general cache so a FLUSHALL cannot wipe security state.",
      "evidence": [
        {
          "resource": "repo://backend/internal/domain/services.go",
          "version": "repo-file-v1:sha256:6b3f4fc67ac725bbb542177170c505724178e3379f922a3720617bcf578b6b99"
        },
