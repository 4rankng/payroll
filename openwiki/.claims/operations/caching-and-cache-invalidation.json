          "version": "repo-file-v1:sha256:e8cdcc833e430d286d049234fd9a57ee5acc1d7491b957f429f671ce53be3589"
        }
      ]
    },
    {
      "id": "claim_7d27602a544c4e9e92a7374f1867d2f4",
      "statement": "Financial-critical data (wallet balance, ledger entries, settlement rows) is never cached and is always read fresh from MySQL because the cost of a stale read exceeds the cost of a query; only hot aggregates with bounded staleness tolerance (banks, settings, dashboard tiles, import progress) participate in the cache.",
