    {
      "id": "claim_7e07207d53e540ff8160902f5a0e003f",
      "statement": "Authorization uses Casbin with a deny-override policy effect: a request is allowed only when at least one allow rule matches AND no deny rule matches, so explicit deny rows beat coarse allow rows and a new endpoint without a policy row is denied by default (fail-closed).",
      "evidence": [
        {
          "resource": "repo://backend/configs/casbin_model.conf",
          "version": "repo-file-v1:sha256:1c277d555f546fd31918d44b4f4a86f20811c746dbd6f6adbe5df732205813aa"
        },
        {
