          "version": "repo-lines-v1:sha256:a6aed4c764d6b5a6218a6d920eb4751305c428c59dbc13359c2541ae8d77a9cf:"
        }
      ]
    },
    {
      "id": "claim_7801f7bc099e4e408ae8a966b6c4665b",
      "statement": "Every protected request runs the same middleware chain in order: Auth (JWT validation, sets user_id and role on the Gin context) → Authorization (Casbin policy check) → Audit context (binds user_id to audit logger); individual handlers cannot opt out.",
