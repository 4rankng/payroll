    {
      "id": "claim_278ea4a467ac42af8aa3b25f03de840e",
      "statement": "Four roles are encoded in the policy: admin has wildcard /api/* access; partner is scoped to projects, employees, timesheets, payrates with explicit deny rows on bulk-approve, bulk-reject, bulk-reset, reject-unpaid, approve-all, reset-all, and edit-requests; adv_partner handles advance-payment pipeline imports and exports without financial actions; employee is limited to /api/v1/me/*.",
      "evidence": [
