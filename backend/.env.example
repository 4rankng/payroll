# Application Configuration
APP_ENV=dev
APP_PORT=8080

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database Configuration
DB_DRIVER=mysql
DB_DSN=user:pass@tcp(localhost:3306)/appdb?parseTime=true&loc=Local
# Database connection pool settings
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h
# Set to true if using external connection pooler like PgBouncer
DB_USE_POOLER=false

# Authentication Configuration
JWT_SECRET=replace-me-with-secure-secret
# JWT TTL is hardcoded at 168h (7 days) — not configurable via env
JWT_REFRESH_TTL=720h

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Rate Limiting Configuration
RATE_LIMIT_RPS=50

# Authorization Configuration (Casbin)
CASBIN_MODEL_PATH=./configs/casbin_model.conf
CASBIN_POLICY_PATH=./configs/casbin_policy.csv

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_DB=0

# Security Configuration
HASH_SECRET=replace-me-with-secure-hash-secret
HASH_SALT=replace-me-with-secure-salt

# Tenant Isolation Configuration
# Maximum concurrent requests per tenant
TENANT_CONCURRENCY_LIMIT=10
# Global request timeout
REQUEST_TIMEOUT=10s
# Per-tenant background worker queue settings
TENANT_QUEUE_WORKERS=5
TENANT_QUEUE_BUFFER=20

# Email Provider Configuration
RESEND_API_KEY=

# Email-OTP 2FA (admin & partner roles). Default OFF — when disabled, login
# behaves exactly as before. To enable:
#   1. Ensure every admin/partner user has an email on file (users without one
#      CANNOT log in once the flag is on).
#   2. Set RESEND_API_KEY so codes can be delivered.
#   3. Set OTP_ENABLE=true and restart.
OTP_ENABLE=false
OTP_CODE_TTL=5m          # pending-session lifetime
OTP_MAX_ATTEMPTS=5       # per-account failed-verify cap before lockout
OTP_LOCK_DURATION=15m    # lockout window once cap is hit
OTP_RESEND_COOLDOWN=30s  # min gap between resend requests

# Self-service email password reset (magic link). Users with an email on file
# can request a single-use 30-min TTL link to set a new password. Reuses the
# Resend infra (RESEND_API_KEY) for delivery. When disabled the endpoints 404.
PASSWORD_RESET_ENABLE=true
PASSWORD_RESET_TOKEN_TTL=30m       # single-use token lifetime
PASSWORD_RESET_RATE_LIMIT=3        # max requests per normalized email per hour
PASSWORD_RESET_URL=https://tingting.vip/reset-password  # base URL for the magic link (must match the deployed frontend)

# Zalo ZNS employee password reset (mobile channel).
# These are BOOTSTRAP-ONLY SEED VALUES. On first boot, if the zalo.credentials
# settings row is empty, it is seeded from here. Thereafter the admin UI
# (/admin/settings?tab=zalo) is authoritative and these are IGNORED. See
# docs/runbooks/zalo-oa-connect.md for the admin connect flow.
ZALO_RESET_ENABLE=false
ZALO_USE_SANDBOX=false              # dev only: mock the ZNS send, log the OTP to the terminal (no Zalo OA needed)
ZALO_APP_ID=                        # payroll OA "TingTing Soft" (NOT tuyennhanvien.vn)
ZALO_SECRET_KEY=                    # never commit; rotate via OA Console or admin UI
ZALO_RESET_TEMPLATE_ID=617976       # OTP-ZNS-v1 (3 params: otp_code, user_fullname, otp_valid_in_minutes)
ZALO_OAUTH_CALLBACK_URL=https://tingting.vip/admin/settings?tab=zalo  # FRONTEND route; Zalo redirects here with ?code=&state=, the SPA POSTs them to the API (which needs the admin JWT in the Authorization header — a direct browser redirect to the API would not carry it)
ZALO_RESET_CODE_TTL=10m             # OTP session lifetime


# Google OIDC ("Sign in with Google"). The client ID is the id_token audience
# (public, not a secret). GOOGLE_OAUTH_ENABLED=false disables the flow entirely.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=

# Self-hosted image CAPTCHA (base64Captcha + Redis). When enabled, a digit-image
# CAPTCHA is required after CAPTCHA_THRESHOLD consecutive login failures.
# Default OFF — purely additive.
CAPTCHA_ENABLE=false
CAPTCHA_THRESHOLD=3       # failed logins before CAPTCHA is required
CAPTCHA_CODE_TTL=5m       # challenge lifetime
CAPTCHA_CODE_LENGTH=5     # number of digits in the code

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_CANCEL=
PAYOS_WEBHOOK_SUCCESS=

ENABLE_NINEPAY=false
ENABLE_NINEPAY_FOR_EMPLOYEE=false

NINEPAY_MERCHANT_KEY=
NINEPAY_SECRET_KEY=
NINEPAY_SECRET_KEY_CHECKSUM=

NINEPAY_ENDPOINT=

NINEPAY_IPN_URL=

NINEPAY_WEB_MERCHANT_ID=


ENABLE_ONEPAY=false
ENABLE_ONEPAY_FOR_EMPLOYEE=false
ENABLE_ONEPAY_FOR_BULK_TRANSFER=false

ONEPAY_PARTNER_ID=
ONEPAY_PARTNER_KEY=
ONEPAY_ACCOUNT_ID=

ONEPAY_ENDPOINT=

ONEPAY_IPN_URL=
# Request expiry in seconds (default 6000).
ONEPAY_REQUEST_EXPIRY_SECONDS=6000
# HTTP timeout for OnePay API calls (default 30s).
ONEPAY_HTTP_TIMEOUT=30s
# Max transactions per second (default 3).
ONEPAY_TPS=3
# Queue buffer capacity (default 100).
ONEPAY_QUEUE_BUFFER=100=
# Comma-separated exact IPs or CIDR ranges allowed to send OnePay IPNs.
ONEPAY_ALLOWED_IPS=118.70.247.80/29,118.71.0.16/29,101.99.11.176/29,116.97.110.80/29,163.227.219.0/24,202.9.84.0/24
# Set true only when the raw TCP peer is the OnePay client rather than a trusted reverse proxy.
ONEPAY_ALLOWED_IPS_USE_REMOTE_ADDR=false
MOCK_ONEPAY_PUBLIC_URL=http://localhost:9002
MOCK_ONEPAY_IPN_URL=http://host.docker.internal:8080/api/v1/webhooks/disbursement/1pay
MOCK_ONEPAY_IPN_DELAY=3s
MOCK_ONEPAY_SLOW_DELAY=5m
MOCK_ONEPAY_SKIP_VERIFY=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tingting.vip

# Business timezone — the app serves Vietnamese users only; all date math must use GMT+7
TZ=Asia/Ho_Chi_Minh
