# Application Configuration
APP_ENV=dev
APP_PORT=8080

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database Configuration
DB_DRIVER=mysql
DB_DSN=user:pass@tcp(localhost:3306)/appdb?parseTime=true&loc=Local
# Database connection pool settings
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h
# Set to true if using external connection pooler like PgBouncer
DB_USE_POOLER=false

# Authentication Configuration
JWT_SECRET=replace-me-with-secure-secret
# JWT TTL is hardcoded at 168h (7 days) — not configurable via env
JWT_REFRESH_TTL=720h

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Rate Limiting Configuration
RATE_LIMIT_RPS=50

# Authorization Configuration (Casbin)
CASBIN_MODEL_PATH=./configs/casbin_model.conf
CASBIN_POLICY_PATH=./configs/casbin_policy.csv

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_DB=0

# Security Configuration
HASH_SECRET=replace-me-with-secure-hash-secret
HASH_SALT=replace-me-with-secure-salt

# Tenant Isolation Configuration
# Maximum concurrent requests per tenant
TENANT_CONCURRENCY_LIMIT=10
# Global request timeout
REQUEST_TIMEOUT=10s
# Per-tenant background worker queue settings
TENANT_QUEUE_WORKERS=5
TENANT_QUEUE_BUFFER=20

# Email Provider Configuration
RESEND_API_KEY=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_CANCEL=
PAYOS_WEBHOOK_SUCCESS=

# Disbursement: 9pay provider
#
# Two boolean flags gate the integration; both default to false:
#   ENABLE_NINEPAY               — master switch. False = 9pay dormant
#                                  (provider not registered, debug routes
#                                  404, webhook receiver 404). True =
#                                  provider registers (assuming creds
#                                  below are set), debug routes mounted,
#                                  webhook receiver mounted.
#   ENABLE_NINEPAY_FOR_EMPLOYEE  — only meaningful when ENABLE_NINEPAY=true.
#                                  Routes employee/payroll disbursements
#                                  through 9pay vs. the existing flow.
#                                  False = 9pay reachable from the debug
#                                  rig only; real money continues through
#                                  the prior path.
#
# Suggested rollout: stage 1 set ENABLE_NINEPAY=true with
# ENABLE_NINEPAY_FOR_EMPLOYEE=false (test in isolation via debug rig);
# stage 2 flip ENABLE_NINEPAY_FOR_EMPLOYEE=true (live).
ENABLE_NINEPAY=false
ENABLE_NINEPAY_FOR_EMPLOYEE=false
# Credentials are required when ENABLE_NINEPAY=true; if blank, the
# provider still does not register and a log line says so at boot.
NINEPAY_MERCHANT_KEY=
NINEPAY_SECRET_KEY=
NINEPAY_SECRET_KEY_CHECKSUM=
# Defaults to https://payment.9pay.vn (production). Override with
# https://sand-payment.9pay.vn for sandbox testing.
NINEPAY_ENDPOINT=https://payment.9pay.vn
# Public URL where 9pay should POST IPN callbacks, e.g.
#   https://api.tingting.vip/api/v1/webhooks/disbursement/9pay
NINEPAY_IPN_URL=
# Numeric 9pay merchant ID for the reconciliation export filter
# (the merchant_id query param on /api/transaction/disbursement/export).
# This is NOT the alphanumeric NINEPAY_MERCHANT_KEY — it is a numeric
# identifier visible in the 9pay back-office URL after login. Empty
# means "no filter" (return every transaction the portal user can see),
# which is what the payroll backend wants in the common case. Set only
# if the portal account has access to multiple merchants and exports
# must be scoped to one. Sandbox vietphap example: 2535.
NINEPAY_WEB_MERCHANT_ID=

# Disbursement: OnePay provider
#
# Two boolean flags gate the integration; both default to false:
#   ENABLE_ONEPAY               — master switch. False = OnePay dormant
#                                  (provider not registered, routes 404,
#                                  webhook receiver 404).
#   ENABLE_ONEPAY_FOR_EMPLOYEE  — only meaningful when ENABLE_ONEPAY=true.
#                                  Routes employee/payroll disbursements
#                                  through OnePay vs. the existing flow.
ENABLE_ONEPAY=false
ENABLE_ONEPAY_FOR_EMPLOYEE=false
ENABLE_ONEPAY_FOR_BULK_TRANSFER=false
# Credentials are required when ENABLE_ONEPAY=true; if blank, the
# provider still does not register and a log line says so at boot.
ONEPAY_PARTNER_ID=
ONEPAY_PARTNER_KEY=
ONEPAY_ACCOUNT_ID=
# Defaults to https://onepay.vn (production). Override with
# https://mtf.onepay.vn for sandbox testing.
ONEPAY_ENDPOINT=https://onepay.vn
# Public URL where OnePay should POST IPN callbacks.
ONEPAY_IPN_URL=https://tingting.vip/api/v1/webhooks/disbursement/1pay
# Request expiry in seconds (default 6000).
ONEPAY_REQUEST_EXPIRY_SECONDS=6000
# HTTP timeout for OnePay API calls (default 30s).
ONEPAY_HTTP_TIMEOUT=30s
# Max transactions per second (default 3).
ONEPAY_TPS=3
# Queue buffer capacity (default 100).
ONEPAY_QUEUE_BUFFER=100
#
# Sandbox credentials (for testing):
# ONEPAY_PARTNER_ID=TESTVFICPO
# ONEPAY_PARTNER_KEY=C2B5DA903DAE19E215454211C66A59DD
# ONEPAY_ACCOUNT_ID=666894931888
# ONEPAY_ENDPOINT=https://mtf.onepay.vn

# 9pay Mock Polling (only used by the 9pay-mock Docker container)
# The mock scans provider_transactions for stale pending rows and posts
# completion IPNs to recover from restarts or lost goroutines.
# MOCK_DB_DSN=root:rootpassword@tcp(mysql:3306)/payroll_db?parseTime=true&loc=UTC

# OnePay sandbox container (mocks mtf.onepay.vn locally on port 9002)
#
# When developing against the local sandbox, override ONEPAY_ENDPOINT
# from inside the backend process:
#   ONEPAY_ENDPOINT=http://localhost:9002
#
# These MOCK_ONEPAY_* vars only affect the docker container, never the
# backend.
MOCK_ONEPAY_PUBLIC_URL=http://localhost:9002
MOCK_ONEPAY_IPN_URL=http://host.docker.internal:8080/api/v1/webhooks/disbursement/1pay
MOCK_ONEPAY_IPN_DELAY=3s
MOCK_ONEPAY_SLOW_DELAY=5m
MOCK_ONEPAY_SKIP_VERIFY=false
# Optional: enables the stale-row poller inside the OnePay sandbox.
# MOCK_ONEPAY_DB_DSN=root:rootpassword@tcp(mysql:3306)/payroll_db?parseTime=true&loc=UTC

# Push Notifications (Web Push via VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tingting.vip
