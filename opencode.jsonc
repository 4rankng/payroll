{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openwiki": {
      "type": "local",
      "command": [
        "openwiki",
        "mcp",
        "--host",
        "opencode"
      ],
      "enabled": true
    },
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "/Volumes/LexarSSD/projects/payroll"
      ]
    }
  }
}
